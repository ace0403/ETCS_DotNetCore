<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Print = send to Windows default printer. Preview = save PNG and open viewer (no printer). PrintAndPreview = both. -->
    <add key="ReceiptPrintMode" value="Print" />
    <!-- When Preview mode is active, open the saved PNG in the default image viewer. -->
    <add key="ReceiptPreviewOpenViewer" value="true" />
    <!-- Optional folder for preview PNG files. Empty = %TEMP%\ETCS\ReceiptPreview -->
    <add key="ReceiptPreviewFolder" value="" />
  </appSettings>
</configuration>
