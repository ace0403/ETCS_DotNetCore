<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS keeps the site process alive only when configured for AlwaysRunning + Preload.
  Without that, BackgroundService (email sender) stops after idle timeout even though
  running ETCS.API.exe interactively keeps working.
  Also set App Pool: Start Mode = AlwaysRunning, Idle Time-out (minutes) = 0.
  Site: Preload Enabled = True. Install "Application Initialization" IIS feature.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\ETCS.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="true">
        <add initializationPage="/health" />
      </applicationInitialization>
    </system.webServer>
  </location>
</configuration>
