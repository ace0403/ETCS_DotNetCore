@model ETCS.Web.Infrastructure.Navigation.ParentPortalNavigationAccess
@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var historyView = Context.Request.Query["view"].ToString();
    var isHistory = string.Equals(currentController, "History", StringComparison.OrdinalIgnoreCase);
    var isOrders = isHistory && !string.Equals(historyView, "transactions", StringComparison.OrdinalIgnoreCase);
    var isTransactions = isHistory && string.Equals(historyView, "transactions", StringComparison.OrdinalIgnoreCase);

    bool IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    string NavIcon(string fileName) => Url.Content($"~/images/icons/{fileName}");
}
<nav class="pc-sidebar">
    <div class="navbar-wrapper">
        <div class="m-header">
            <a asp-controller="Dashboard" asp-action="Index" class="etcs-brand">
                <img src="~/images/icons/cutlery_w.svg" class="etcs-brand-logo" alt="ETCS" />
                <span class="etcs-brand-text">
                    <span class="etcs-brand-title">MealHub</span>
                    <span class="etcs-brand-subtitle">Parent Portal</span>
                </span>
            </a>
        </div>
        <div class="navbar-content">
            <ul class="pc-navbar etcs-nav">
                <li class="pc-item@(IsActive("Dashboard") ? " active" : "")">
                    <a asp-controller="Dashboard" asp-action="Index" class="pc-link@(IsActive("Dashboard") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("dashboard.svg")')"></span>
                        <span class="pc-mtext">Dashboard</span>
                    </a>
                </li>
                <li class="pc-item@(IsActive("MyKids") ? " active" : "")">
                    <a asp-controller="MyKids" asp-action="Index" class="pc-link@(IsActive("MyKids") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("users.svg")')"></span>
                        <span class="pc-mtext">My Children</span>
                    </a>
                </li>
                @if (Model is { ShowPreOrderMeal: true })
                {
                    <li class="pc-item@(IsActive("MealCombo") ? " active" : "")">
                        <a asp-controller="MealCombo" asp-action="Index" class="pc-link@(IsActive("MealCombo") ? " active" : "")">
                            <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("plan.svg")')"></span>
                            <span class="pc-mtext">Pre-Order Meal</span>
                        </a>
                    </li>
                }
                @* <li class="pc-item@(IsActive("AlaCarte") ? " active" : "")">
                    <a asp-controller="AlaCarte" asp-action="Index" class="pc-link@(IsActive("AlaCarte") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("cutlery.svg")')"></span>
                        <span class="pc-mtext">A La Carte</span>
                    </a>
                </li> *@
                <li class="pc-item@(IsActive("OrderCalendar") ? " active" : "")">
                    <a asp-controller="OrderCalendar" asp-action="Index" class="pc-link@(IsActive("OrderCalendar") ? " active" : "")">
                        <span class="pc-micon"><i class="ti ti-calendar"></i></span>
                        <span class="pc-mtext">Order Calendar</span>
                    </a>
                </li>
                @if (Model is { ShowWallet: true })
                {
                    <li class="pc-item@(IsActive("Topup") ? " active" : "")">
                        <a asp-controller="Topup" asp-action="Index" class="pc-link@(IsActive("Topup") ? " active" : "")">
                            <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("wallet.svg")')"></span>
                            <span class="pc-mtext">Wallet</span>
                        </a>
                    </li>
                }
                @* <li class="pc-item@(isOrders ? " active" : "")">
                    <a asp-controller="History" asp-action="Index" class="pc-link@(isOrders ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("shopping.svg")')"></span>
                        <span class="pc-mtext">Orders</span>
                    </a>
                </li> *@
                <li class="pc-item@(isTransactions ? " active" : "")">
                    <a asp-controller="History" asp-action="Index" class="pc-link@(isTransactions ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("money.svg")')"></span>
                        <span class="pc-mtext">Transactions</span>
                    </a>
                </li>
                <li class="pc-item@(IsActive("Notifications") ? " active" : "")">
                    <a asp-controller="Notifications" asp-action="Index" class="pc-link@(IsActive("Notifications") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("notification.svg")')"></span>
                        <span class="pc-mtext">Notifications</span>
                    </a>
                </li>
                <li class="pc-item@(IsActive("AccountSettings") ? " active" : "")">
                    <a asp-controller="AccountSettings" asp-action="Index" class="pc-link@(IsActive("AccountSettings") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("user.svg")')"></span>
                        <span class="pc-mtext">Account Settings</span>
                    </a>
                </li>
                <li class="pc-item@(IsActive("Support") ? " active" : "")">
                    <a asp-controller="Support" asp-action="Index" class="pc-link@(IsActive("Support") ? " active" : "")">
                        <span class="pc-micon etcs-nav-icon" style="--icon: url('@NavIcon("question.svg")')"></span>
                        <span class="pc-mtext">Support</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="etcs-sidebar-help">
            <h6>Need Help?</h6>
            <p>Contact our support team</p>
            <a asp-controller="Support" asp-action="Index" class="btn">Get Support</a>
        </div>
    </div>
</nav>
