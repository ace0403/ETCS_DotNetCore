@model ETCS.Web.Models.ForgotPasswordRequest
@{
    Layout = null;
    var msg = Context.Request.Query["msg"].FirstOrDefault()?.ToLowerInvariant();
    var showSent = msg == "reset-sent";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - ETCS</title>
    <link rel="icon" href="~/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="~/fonts/inter/inter.css" />
    <link rel="stylesheet" href="~/fonts/tabler-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/custom/dev-style.css" />
    <link rel="stylesheet" href="~/css/custom/legal.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-shell">
        <section class="login-hero" aria-hidden="true">
            <div class="login-hero-bg"></div>
            <div class="login-hero-content">
                <img src="~/images/logo.png" alt="ETCS" class="login-hero-logo" />
                <h1 class="login-hero-title">ETCS Portal</h1>
                <p class="login-hero-text">View balances, meal orders, and student activity from one secure dashboard.</p>
            </div>
        </section>

        <section class="login-panel">
            <div class="login-card">
                <div class="login-card-header text-center">
                    <img src="~/images/logo.png" alt="ETCS" class="login-card-logo" />
                    <h2 class="login-card-title">Forgot password</h2>
                    <p class="login-card-subtitle">Enter your account email and we will send reset instructions if it matches an account.</p>
                </div>

                @if (showSent)
                {
                    <div class="alert alert-success small" role="status">
                        If an account exists for that email, password reset instructions have been sent. Please check your inbox.
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary login-submit w-100">
                        <span>Back to sign in</span>
                        <i class="ti ti-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    <form asp-action="ForgotPassword" method="post" class="login-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label login-label">Email</label>
                            <div class="input-group login-input-group">
                                <span class="input-group-text login-input-addon"><i class="ti ti-mail"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary login-submit w-100">
                            <span>Send reset link</span>
                            <i class="ti ti-arrow-right ms-1"></i>
                        </button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        <a asp-controller="Home" asp-action="Index" class="small text-decoration-none">Back to sign in</a>
                    </p>
                }

                <p class="login-footer text-center mb-0 mt-3">&copy; @DateTime.Now.Year ETCS. All rights reserved.</p>
                <div class="login-footer-links">
                    <a asp-controller="Legal" asp-action="Terms">Terms</a>
                    <a asp-controller="Legal" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Legal" asp-action="Cancellation">Cancellation</a>
                </div>
            </div>
        </section>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/toastr.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/custom/siteurl.js"></script>
    <script src="~/js/custom/common.js"></script>
    <script>
        $(function () {
            initAdminFormValidation('.login-form');
            if (window.location.href.indexOf('?') > -1) {
                history.replaceState('', document.title, removeURLParameter(window.location.href, 'msg'));
            }
        });
    </script>
</body>
</html>
