@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-1">Welcome</h2>
        <p class="text-muted mb-0">Your ETCS parent portal dashboard</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-primary" style="width:48px;height:48px;">
                            <i class="ti ti-wallet text-primary f-20"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted">Account Balance</h6>
                        <h4 class="mb-0">—</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-primary" style="width:48px;height:48px;">
                            <i class="ti ti-school text-primary f-20"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted">Students</h6>
                        <h4 class="mb-0">—</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light-primary" style="width:48px;height:48px;">
                            <i class="ti ti-clipboard-list text-primary f-20"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted">Recent Orders</h6>
                        <h4 class="mb-0">—</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title mb-2">Getting started</h5>
        <p class="text-muted mb-0">Your portal is ready. Additional features and navigation items can be added to the sidebar as they become available.</p>
    </div>
</div>
