@model ETCS.Shared.Infrastructure.Admin.Master.Guardians.GuardianChildrenViewModel
@{
    var childCount = Model?.Children?.Count ?? 0;
    ViewData["Title"] = "My Children";
    ViewData["PageSubtitle"] = childCount == 1
        ? "1 child registered"
        : $"{childCount} children registered";
}
<div class="my-kids-page mt-2 mt-md-0">
    <div class="my-kids-hero my-kids-hero-actions">
        <button type="button" class="my-kids-add-btn" onclick="openAddKid()">
            <i class="ti ti-plus" aria-hidden="true"></i>
            Add Child
        </button>
    </div>

    <div class="my-kids-panel" id="kidsListContainer">
        <partial name="_KidsList" model="Model" />
    </div>
</div>

<div class="modal fade" id="addKidModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="div_add_kid"></div>
    </div>
</div>
<div class="modal fade" id="editKidModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="div_edit_kid"></div>
    </div>
</div>

@section Styles {
    <link href="~/css/bootstrap-multiselect.css" rel="stylesheet" />
    <link href="~/css/custom/my-kids.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/js/bootstrap-multiselect.js"></script>
    <script src="~/js/custom/my-kids.js"></script>
}
