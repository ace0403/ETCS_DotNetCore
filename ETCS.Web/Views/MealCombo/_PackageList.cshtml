@model IReadOnlyList<ETCS.Web.Models.MealComboSessionSection>
@using ETCS.Web.Infrastructure.AlaCarte
@using ETCS.Shared.Media
@inject Microsoft.Extensions.Options.IOptions<ETCS.Web.Options.WebOptions> WebOptions
@inject MealImageUrlBuilder ImageUrlBuilder
@{
    Layout = null;
    var currency = WebOptions.Value.DisplayCurrency;
    var selectedMealDate = ViewData["SelectedMealDate"]?.ToString() ?? string.Empty;
    var sessionSections = Model?
        .Where(s => s.DisplayItems.Count > 0)
        .Where(s => int.TryParse(s.MealSessionId, out var sessionId) && sessionId > 0 && !string.IsNullOrWhiteSpace(s.MealSessionName))
        .ToList() ?? [];
}

@if (sessionSections.Count > 0)
{
    <div class="ala-carte-menu-inner menu-browse-inner meal-combo-menu-inner is-showing-all">
        <div class="meal-combo-filter-bar">
            <div class="meal-session-tabs@(sessionSections.Count == 1 ? " meal-session-tabs--single" : "")" role="tablist" aria-label="Meal sessions">
                @for (var tabIndex = 0; tabIndex < sessionSections.Count; tabIndex++)
                {
                    var tabSection = sessionSections[tabIndex];
                    var tabSessionName = tabSection.MealSessionName.Trim();
                    var tabSessionCss = string.IsNullOrWhiteSpace(tabSection.MealSessionCssClass) ? string.Empty : tabSection.MealSessionCssClass.Trim();
                    var tabIcon = MealSessionDisplayHelper.ResolveIcon(tabSessionName);
                    var tabSubtitle = MealSessionDisplayHelper.ResolveSubtitle(tabSessionName);
                    var isFirstTab = tabIndex == 0;

                    <button type="button"
                            class="meal-session-tab@(isFirstTab ? " is-active" : "")"
                            data-meal-session-id="@tabSection.MealSessionId"
                            role="tab"
                            aria-selected="@(isFirstTab ? "true" : "false")"
                            aria-controls="meal-session-panel-@tabSection.MealSessionId"
                            id="meal-session-tab-@tabSection.MealSessionId">
                        <span class="meal-session-tab-icon" aria-hidden="true">
                            <i class="@tabIcon"></i>
                        </span>
                        <span class="meal-session-tab-copy">
                            <span class="meal-session-tab-title">@tabSessionName</span>
                            <span class="meal-session-tab-subtitle">@tabSubtitle</span>
                        </span>
                    </button>
                }
            </div>

            @for (var chipIndex = 0; chipIndex < sessionSections.Count; chipIndex++)
            {
                var chipSection = sessionSections[chipIndex];
                var mealTypeGroups = chipSection.MealTypeFilters;
                var isFirstChipBar = chipIndex == 0;
                var hasMenuItems = chipSection.DisplayItems.Count > 0;

                if (hasMenuItems)
                {
                    <div class="menu-category-chips meal-combo-category-chips@(isFirstChipBar ? "" : " d-none")"
                         data-meal-session-id="@chipSection.MealSessionId"
                         role="tablist"
                         aria-label="Meal categories">
                        <button type="button"
                                class="menu-category-chip is-active"
                                data-meal-type="all"
                                role="tab"
                                aria-selected="true">
                            All
                        </button>
                        @foreach (var typeGroup in mealTypeGroups)
                        {
                            <button type="button"
                                    class="menu-category-chip"
                                    data-meal-type="@typeGroup.FilterKey"
                                    role="tab"
                                    aria-selected="false">
                                @typeGroup.TypeName
                            </button>
                        }
                    </div>
                }
            }
        </div>

        @for (var panelIndex = 0; panelIndex < sessionSections.Count; panelIndex++)
        {
            var sessionSection = sessionSections[panelIndex];
            var isFirstPanel = panelIndex == 0;
            var isActivePanel = isFirstPanel;

            <section class="menu-session-panel@(isActivePanel ? " is-active" : "")"
                     id="meal-session-panel-@sessionSection.MealSessionId"
                     data-meal-session-id="@sessionSection.MealSessionId"
                     role="tabpanel"
                     aria-labelledby="meal-session-tab-@sessionSection.MealSessionId">

                @if (sessionSection.DisplayItems.Count > 0)
                {
                    <div class="menu-session-items">
                        <div class="menu-card-grid">
                            @foreach (var card in sessionSection.DisplayItems)
                            {
                                @if (!card.IsAddon)
                                {
                                    var item = card.Package!;
                                var hasImage = !string.IsNullOrWhiteSpace(item.ImageName);
                                var thumbnailPath = ImageUrlBuilder.GetThumbnailPath(MealImageKind.MealCombo, item.ImageName);
                                var allergiesName = AlaCarteAllergenHelper.ParseAllergenNames(item.StudentAllergies);
                                var isAllergyItem = AlaCarteAllergenHelper.HasAllergens(item.StudentAllergies);
                                var nutritionStats = AlaCarteNutritionHelper.GetPrimaryStats(item.NutritionList);
                                var searchText = $"{item.PackageName} {item.ItemsName} {item.Detail}".Trim().ToLowerInvariant();
                                var menuTypeName = AlaCarteMealTypeHelper.ResolveMenuTypeBadgeName(item.MealCategoryName);
                                var menuTypeIcon = AlaCarteMealTypeHelper.ResolveIcon(menuTypeName);
                                var typeFilterKey = AlaCarteMealTypeHelper.ResolveFilterKey(item.MealTypeId, item.MealTypeName);

                                <article class="menu-meal-card menu-meal-card--rich meal-item meal-combo-package-item"
                                         role="button"
                                         tabindex="0"
                                         aria-pressed="false"
                                         data-meal-type-id="@typeFilterKey"
                                         data-search-text="@searchText">
                                    <div class="menu-meal-card-media @(hasImage ? "" : "is-placeholder")">
                                        <span class="menu-selected-check" aria-hidden="true">
                                            <i class="ti ti-check"></i>
                                        </span>
                                        <span class="menu-meal-type-badge">
                                            <i class="@menuTypeIcon" aria-hidden="true"></i>
                                            @menuTypeName
                                        </span>
                                        <span class="menu-meal-card-placeholder" aria-hidden="true">
                                            <i class="ti ti-tools-kitchen-2"></i>
                                        </span>
                                        @if (hasImage)
                                        {
                                            <img src="@thumbnailPath"
                                                 onerror="this.onerror=null;this.classList.add('is-broken');this.parentElement.classList.add('is-placeholder');"
                                                 alt="@item.PackageName"
                                                 class="menu-meal-card-img" />
                                        }
                                        <div class="menu-image-disclaimer" role="note">
                                            <i class="ti ti-info-circle" aria-hidden="true"></i>
                                            <span class="menu-image-disclaimer-copy">
                                                <strong>Image for illustration purposes only.</strong>
                                                <span>Actual product may vary in appearance.</span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="menu-meal-card-body">
                                        <div class="menu-meal-card-headline">
                                            <div class="menu-meal-card-copy">
                                                <h6 class="menu-meal-card-name">
                                                    @item.PackageName
                                                    <input type="checkbox" class="d-none meal-line-checkbox" value="@item.Id" data-line-type="combo" />
                                                </h6>
                                                @if (!string.IsNullOrWhiteSpace(item.Detail))
                                                {
                                                    <p class="menu-meal-card-detail" title="@item.Detail">@item.Detail</p>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item.ItemsName))
                                                {
                                                    <p class="menu-meal-card-detail" title="@item.ItemsName">Includes: @item.ItemsName</p>
                                                }
                                            </div>
                                            <div class="menu-meal-card-actions">
                                                <span class="menu-meal-card-price">@currency @item.TotalPrice.ToString("0.00")</span>
                                                <span class="menu-add-btn" aria-hidden="true">
                                                    <i class="ti ti-plus menu-add-icon"></i>
                                                    <i class="ti ti-check menu-added-icon"></i>
                                                    <span class="menu-add-label">Add</span>
                                                    <span class="menu-added-label">Added</span>
                                                </span>
                                            </div>
                                        </div>

                                        @if (nutritionStats.Count > 0 || item.IngredientNames.Count > 0)
                                        {
                                            <div class="menu-card-facts">
                                                @if (nutritionStats.Count > 0)
                                                {
                                                    <div class="menu-nutrition-panel" data-count="@nutritionStats.Count" aria-label="Nutrition">
                                                        @foreach (var stat in nutritionStats)
                                                        {
                                                            <div class="menu-nutrition-stat is-@stat.Key">
                                                                <span class="menu-nutrition-name">
                                                                    @if (!string.IsNullOrEmpty(stat.Emoji))
                                                                    {
                                                                        <span class="menu-nutrition-emoji" aria-hidden="true">@stat.Emoji</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="@stat.IconClass" aria-hidden="true"></i>
                                                                    }
                                                                    <span class="menu-nutrition-label">@stat.Label</span>
                                                                </span>
                                                                <span class="menu-nutrition-amount">
                                                                    <span class="menu-nutrition-value">@stat.Value</span>
                                                                </span>
                                                                <span class="menu-nutrition-unit">@stat.Unit</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (item.Ingredients.Count > 0)
                                                {
                                                    var studentAllergens = new HashSet<string>(AlaCarteAllergenHelper.ParseAllergenList(item.StudentAllergies), StringComparer.OrdinalIgnoreCase);
                                                    var orderedIngredients = item.Ingredients
                                                        .OrderByDescending(ing => studentAllergens.Contains(ing.Name))
                                                        .ToList();
                                                    var maxIngredientChips = 6;
                                                    var visibleIngredients = orderedIngredients.Take(maxIngredientChips).ToList();
                                                    var extraIngredientCount = orderedIngredients.Count - visibleIngredients.Count;

                                                    <div class="menu-ingredient-panel" aria-label="Ingredients">
                                                        <div class="menu-ingredient-chips">
                                                            <div class="menu-ingredient-label mb-0">Allergen</div>
                                                            @foreach (var ingredient in visibleIngredients)
                                                            {
                                                                var isStudentAllergen = studentAllergens.Contains(ingredient.Name);
                                                                var iconFile = AlaCarteAllergenHelper.NormalizeIconFileName(ingredient.Icon);
                                                                <span class="menu-ingredient-chip@(isStudentAllergen ? " is-alert" : "")">
                                                                    @if (!string.IsNullOrEmpty(iconFile))
                                                                    {
                                                                        <img class="menu-ingredient-icon" src="@Url.Content($"~/images/icons/{iconFile}")" alt="" />
                                                                    }
                                                                    @ingredient.Name
                                                                </span>
                                                            }
                                                            @if (extraIngredientCount > 0)
                                                            {
                                                                <span class="menu-ingredient-more">+@extraIngredientCount</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <input type="hidden" class="meal-item-date" value="@selectedMealDate" />
                                    <input type="hidden" class="is-allergen-item" value="@(isAllergyItem ? "true" : "false")" />
                                    <input type="hidden" class="allergies-name" value="@allergiesName" />
                                    <input type="hidden" class="item-price" value="@item.TotalPrice" />
                                </article>
                                }
                                else
                                {
                                    var item = card.Addon!;
                                var hasImage = !string.IsNullOrWhiteSpace(item.ImageName);
                                var thumbnailPath = ImageUrlBuilder.GetThumbnailPath(MealImageKind.MealItem, item.ImageName);
                                var allergiesName = AlaCarteAllergenHelper.ParseAllergenNames(item.StudentAllergies);
                                var isAllergyItem = AlaCarteAllergenHelper.HasAllergens(item.StudentAllergies);
                                var nutritionStats = AlaCarteNutritionHelper.GetPrimaryStats(item.NutritionList);
                                var searchText = $"{item.ItemName} {item.Detail}".Trim().ToLowerInvariant();
                                var menuTypeName = AlaCarteMealTypeHelper.ResolveMenuTypeBadgeName(item.MealCategoryName);
                                var menuTypeIcon = AlaCarteMealTypeHelper.ResolveIcon(menuTypeName);
                                var typeFilterKey = AlaCarteMealTypeHelper.ResolveFilterKey(item.MealTypeId, item.MealTypeName);

                                <article class="menu-meal-card menu-meal-card--rich meal-item meal-combo-addon-item"
                                         role="button"
                                         tabindex="0"
                                         aria-pressed="false"
                                         data-meal-type-id="@typeFilterKey"
                                         data-search-text="@searchText">
                                    <div class="menu-meal-card-media @(hasImage ? "" : "is-placeholder")">
                                        <span class="menu-selected-check" aria-hidden="true">
                                            <i class="ti ti-check"></i>
                                        </span>
                                        <span class="menu-meal-type-badge">
                                            <i class="@menuTypeIcon" aria-hidden="true"></i>
                                            @menuTypeName
                                        </span>
                                        <span class="menu-meal-card-placeholder" aria-hidden="true">
                                            <i class="ti ti-tools-kitchen-2"></i>
                                        </span>
                                        @if (hasImage)
                                        {
                                            <img src="@thumbnailPath"
                                                 onerror="this.onerror=null;this.classList.add('is-broken');this.parentElement.classList.add('is-placeholder');"
                                                 alt="@item.ItemName"
                                                 class="menu-meal-card-img" />
                                        }
                                        <div class="menu-image-disclaimer" role="note">
                                            <i class="ti ti-info-circle" aria-hidden="true"></i>
                                            <span class="menu-image-disclaimer-copy">
                                                <strong>Image for illustration purposes only.</strong>
                                                <span>Actual product may vary in appearance.</span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="menu-meal-card-body">
                                        <div class="menu-meal-card-headline">
                                            <div class="menu-meal-card-copy">
                                                <h6 class="menu-meal-card-name">
                                                    @item.ItemName
                                                    <input type="checkbox" class="d-none meal-line-checkbox" value="@item.Id" data-line-type="addon" />
                                                </h6>
                                                @if (!string.IsNullOrWhiteSpace(item.Detail))
                                                {
                                                    <p class="menu-meal-card-detail" title="@item.Detail">@item.Detail</p>
                                                }
                                            </div>
                                            <div class="menu-meal-card-actions">
                                                <span class="menu-meal-card-price">@currency @item.Price.ToString("0.00")</span>
                                                <span class="menu-add-btn" aria-hidden="true">
                                                    <i class="ti ti-plus menu-add-icon"></i>
                                                    <i class="ti ti-check menu-added-icon"></i>
                                                    <span class="menu-add-label">Add</span>
                                                    <span class="menu-added-label">Added</span>
                                                </span>
                                            </div>
                                        </div>

                                        @if (nutritionStats.Count > 0 || item.IngredientNames.Count > 0)
                                        {
                                            <div class="menu-card-facts">
                                                @if (nutritionStats.Count > 0)
                                                {
                                                    <div class="menu-nutrition-panel" data-count="@nutritionStats.Count" aria-label="Nutrition">
                                                        @foreach (var stat in nutritionStats)
                                                        {
                                                            <div class="menu-nutrition-stat is-@stat.Key">
                                                                <span class="menu-nutrition-name">
                                                                    @if (!string.IsNullOrEmpty(stat.Emoji))
                                                                    {
                                                                        <span class="menu-nutrition-emoji" aria-hidden="true">@stat.Emoji</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="@stat.IconClass" aria-hidden="true"></i>
                                                                    }
                                                                    <span class="menu-nutrition-label">@stat.Label</span>
                                                                </span>
                                                                <span class="menu-nutrition-amount">
                                                                    <span class="menu-nutrition-value">@stat.Value</span>
                                                                </span>
                                                                <span class="menu-nutrition-unit">@stat.Unit</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (item.Ingredients.Count > 0)
                                                {
                                                    var studentAllergens = new HashSet<string>(AlaCarteAllergenHelper.ParseAllergenList(item.StudentAllergies), StringComparer.OrdinalIgnoreCase);
                                                    var orderedIngredients = item.Ingredients
                                                        .OrderByDescending(ing => studentAllergens.Contains(ing.Name))
                                                        .ToList();
                                                    var maxIngredientChips = 6;
                                                    var visibleIngredients = orderedIngredients.Take(maxIngredientChips).ToList();
                                                    var extraIngredientCount = orderedIngredients.Count - visibleIngredients.Count;

                                                    <div class="menu-ingredient-panel" aria-label="Ingredients">
                                                        <div class="menu-ingredient-chips">
                                                            <div class="menu-ingredient-label mb-0">Allergen</div>
                                                            @foreach (var ingredient in visibleIngredients)
                                                            {
                                                                var isStudentAllergen = studentAllergens.Contains(ingredient.Name);
                                                                var iconFile = AlaCarteAllergenHelper.NormalizeIconFileName(ingredient.Icon);
                                                                <span class="menu-ingredient-chip@(isStudentAllergen ? " is-alert" : "")">
                                                                    @if (!string.IsNullOrEmpty(iconFile))
                                                                    {
                                                                        <img class="menu-ingredient-icon" src="@Url.Content($"~/images/icons/{iconFile}")" alt="" />
                                                                    }
                                                                    @ingredient.Name
                                                                </span>
                                                            }
                                                            @if (extraIngredientCount > 0)
                                                            {
                                                                <span class="menu-ingredient-more" title="@string.Join(", ", orderedIngredients.Skip(maxIngredientChips).Select(x => x.Name))">+@extraIngredientCount</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <input type="hidden" class="meal-item-date" value="@selectedMealDate" />
                                    <input type="hidden" class="is-allergen-item" value="@(isAllergyItem ? "true" : "false")" />
                                    <input type="hidden" class="allergies-name" value="@allergiesName" />
                                    <input type="hidden" class="item-price" value="@item.Price" />
                                </article>
                                }
                            }
                        </div>
                    </div>
                }
            </section>
        }

        <div class="menu-filter-empty" id="menuFilterEmpty" hidden>
            <p class="text-muted mb-0">No items match your search for this session.</p>
        </div>
    </div>
}
else
{
    <div class="ala-carte-empty-state">
        <div class="ala-carte-empty-icon">
            <i class="ti ti-mood-empty"></i>
        </div>
        <h5>No items available</h5>
        <p class="text-muted mb-0">Try another date or child.</p>
    </div>
}
