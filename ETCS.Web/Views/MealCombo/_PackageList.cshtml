@model IReadOnlyList<ETCS.Web.Models.MealComboPackageTypeGroup>
@using ETCS.Web.Infrastructure.AlaCarte
@using ETCS.Shared.Media
@inject Microsoft.Extensions.Options.IOptions<ETCS.Web.Options.WebOptions> WebOptions
@inject MealImageUrlBuilder ImageUrlBuilder
@{
    Layout = null;
    var currency = WebOptions.Value.DisplayCurrency;
    var selectedMealDate = ViewData["SelectedMealDate"]?.ToString() ?? string.Empty;
    var groups = Model?.Where(g => g.Packages.Count > 0).ToList() ?? [];
}

@if (groups.Count > 0)
{
    <div class="ala-carte-menu-inner menu-browse-inner meal-combo-menu-inner is-showing-all">
        <div class="menu-category-chips" role="tablist" aria-label="Package categories">
            <button type="button"
                    class="menu-category-chip is-active"
                    data-meal-type="all"
                    role="tab"
                    aria-selected="true">
                All
            </button>
            @foreach (var group in groups)
            {
                var typeName = string.IsNullOrWhiteSpace(group.MealTypeName) ? "Meals" : group.MealTypeName.Trim();
                <button type="button"
                        class="menu-category-chip"
                        data-meal-type="@group.MealTypeId"
                        role="tab"
                        aria-selected="false">
                    @typeName
                </button>
            }
        </div>

        <div class="menu-card-grid" id="div_meal">
            @foreach (var group in groups)
            {
                foreach (var item in group.Packages)
                {
                    var hasImage = !string.IsNullOrWhiteSpace(item.ImageName);
                    var thumbnailPath = ImageUrlBuilder.GetThumbnailPath(MealImageKind.MealCombo, item.ImageName);
                    var allergiesName = AlaCarteAllergenHelper.ParseAllergenNames(item.StudentAllergies);
                    var isAllergyItem = AlaCarteAllergenHelper.HasAllergens(item.StudentAllergies);
                    var allergenList = allergiesName
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .ToList();
                    var calorieBadge = AlaCarteNutritionHelper.TryFormatCalorieBadge(item.NutritionList);
                    var searchText = $"{item.PackageName} {item.ItemsName} {item.Detail}".Trim().ToLowerInvariant();
                    var typeName = string.IsNullOrWhiteSpace(group.MealTypeName) ? "Meals" : group.MealTypeName.Trim();

                    <article class="menu-meal-card meal-item meal-combo-package-item"
                             role="button"
                             tabindex="0"
                             aria-pressed="false"
                             data-meal-type-id="@group.MealTypeId"
                             data-search-text="@searchText">
                        <div class="menu-meal-card-media @(hasImage ? "" : "is-placeholder")">
                            @if (item.IsPopular)
                            {
                                <span class="menu-popular-badge">
                                    <i class="ti ti-flame" aria-hidden="true"></i>
                                    Popular
                                </span>
                            }
                            <span class="menu-selected-check" aria-hidden="true">
                                <i class="ti ti-check"></i>
                            </span>
                            <span class="menu-meal-type-badge">@typeName</span>
                            <span class="menu-meal-card-placeholder" aria-hidden="true">
                                <i class="ti ti-tools-kitchen-2"></i>
                            </span>
                            @if (hasImage)
                            {
                                <img src="@thumbnailPath"
                                     onerror="this.onerror=null;this.classList.add('is-broken');this.parentElement.classList.add('is-placeholder');"
                                     alt="@item.PackageName"
                                     class="menu-meal-card-img" />
                            }
                        </div>

                        <div class="menu-meal-card-body">
                            <div class="menu-meal-card-title-row">
                                <h6 class="menu-meal-card-name">
                                    @item.PackageName
                                    <input type="checkbox" class="d-none" value="@item.Id" />
                                </h6>
                                @if (!string.IsNullOrWhiteSpace(calorieBadge))
                                {
                                    <span class="menu-cal-badge">@calorieBadge</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.ItemsName))
                            {
                                <p class="menu-meal-card-includes" title="@item.ItemsName">Includes: @item.ItemsName</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Detail))
                            {
                                <p class="menu-meal-card-detail" title="@item.Detail">@item.Detail</p>
                            }

                            @if (allergenList.Count > 0)
                            {
                                <div class="menu-allergen-chips">
                                    <span class="menu-allergen-chip">
                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                        @(string.Join(", ", allergenList))
                                    </span>
                                </div>
                            }

                            <div class="menu-meal-card-footer">
                                <span class="menu-meal-card-price">@currency @item.TotalPrice.ToString("0.00")</span>
                                <span class="menu-add-btn" aria-hidden="true">
                                    <i class="ti ti-plus menu-add-icon"></i>
                                    <i class="ti ti-check menu-added-icon"></i>
                                    <span class="menu-add-label">Add</span>
                                    <span class="menu-added-label">Added</span>
                                </span>
                            </div>
                        </div>

                        <input type="hidden" class="meal-item-date" value="@selectedMealDate" />
                        <input type="hidden" class="is-allergen-item" value="@(isAllergyItem ? "true" : "false")" />
                        <input type="hidden" class="allergies-name" value="@allergiesName" />
                        <input type="hidden" class="item-price" value="@item.TotalPrice" />
                    </article>
                }
            }
        </div>

        <div class="menu-filter-empty" id="menuFilterEmpty" hidden>
            <p class="text-muted mb-0">No packages match your search or filter.</p>
        </div>
    </div>
}
else
{
    <div class="ala-carte-empty-state">
        <div class="ala-carte-empty-icon">
            <i class="ti ti-mood-empty"></i>
        </div>
        <h5>No combos available</h5>
        <p class="text-muted mb-0">Try another date or child.</p>
    </div>
}
