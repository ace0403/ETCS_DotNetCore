@model IReadOnlyList<ETCS.Web.Models.AlaCarteMealTypeGroup>
@using ETCS.Web.Infrastructure.AlaCarte
@using ETCS.Shared.Media
@inject Microsoft.Extensions.Options.IOptions<ETCS.Web.Options.WebOptions> WebOptions
@inject MealImageUrlBuilder ImageUrlBuilder
@{
    Layout = null;
    var currency = WebOptions.Value.DisplayCurrency;
    var selectedMealDate = ViewData["SelectedMealDate"]?.ToString() ?? string.Empty;
    var groups = Model?.Where(g => g.MealItems.Count > 0).ToList() ?? [];
}

@if (groups.Count > 0)
{
    <div class="ala-carte-menu-inner menu-browse-inner is-showing-all">
        <div class="menu-category-chips" role="tablist" aria-label="Meal categories">
            <button type="button"
                    class="menu-category-chip is-active"
                    data-meal-type="all"
                    role="tab"
                    aria-selected="true">
                All
            </button>
            @foreach (var group in groups)
            {
                var sessionName = string.IsNullOrWhiteSpace(group.MealSessionName) ? "Meals" : group.MealSessionName.Trim();
                <button type="button"
                        class="menu-category-chip"
                        data-meal-type="@group.MealSessionId"
                        role="tab"
                        aria-selected="false">
                    @sessionName
                </button>
            }
        </div>

        <div class="menu-card-grid" id="div_meal">
            @foreach (var group in groups)
            {
                foreach (var item in group.MealItems)
                {
                    var hasImage = !string.IsNullOrWhiteSpace(item.ImageName);
                    var thumbnailPath = ImageUrlBuilder.GetThumbnailPath(MealImageKind.MealItem, item.ImageName);
                    var allergiesName = AlaCarteAllergenHelper.ParseAllergenNames(item.StudentAllergies);
                    var isAllergyItem = AlaCarteAllergenHelper.HasAllergens(item.StudentAllergies);
                    var nutritionStats = AlaCarteNutritionHelper.GetPrimaryStats(item.NutritionList);
                    var searchText = $"{item.ItemName} {item.Detail}".Trim().ToLowerInvariant();
                    var menuTypeName = AlaCarteMealTypeHelper.ResolveMenuTypeBadgeName(item.MealCategoryName);
                    var menuTypeIcon = AlaCarteMealTypeHelper.ResolveIcon(menuTypeName);

                    <article class="menu-meal-card menu-meal-card--rich meal-item"
                             role="button"
                             tabindex="0"
                             aria-pressed="false"
                             data-meal-type-id="@item.MealSessionId"
                             data-search-text="@searchText">
                        <div class="menu-meal-card-media @(hasImage ? "" : "is-placeholder")">
                            @* @if (item.IsPopular)
                            {
                                <span class="menu-popular-badge">
                                    <i class="ti ti-flame" aria-hidden="true"></i>
                                    Popular
                                </span>
                            } *@
                            <span class="menu-selected-check" aria-hidden="true">
                                <i class="ti ti-check"></i>
                            </span>
                            <span class="menu-meal-type-badge">
                                <i class="@menuTypeIcon" aria-hidden="true"></i>
                                @menuTypeName
                            </span>
                            <span class="menu-meal-card-placeholder" aria-hidden="true">
                                <i class="ti ti-tools-kitchen-2"></i>
                            </span>
                            @if (hasImage)
                            {
                                <img src="@thumbnailPath"
                                     onerror="this.onerror=null;this.classList.add('is-broken');this.parentElement.classList.add('is-placeholder');"
                                     alt="@item.ItemName"
                                     class="menu-meal-card-img" />
                            }
                            <div class="menu-image-disclaimer" role="note">
                                <i class="ti ti-info-circle" aria-hidden="true"></i>
                                <span class="menu-image-disclaimer-copy">
                                    <strong>Image for illustration purposes only.</strong>
                                    <span>Actual product may vary in appearance.</span>
                                </span>
                            </div>
                        </div>

                        <div class="menu-meal-card-body">
                            <div class="menu-meal-card-headline">
                                <div class="menu-meal-card-copy">
                                    <h6 class="menu-meal-card-name">
                                        @item.ItemName
                                        <input type="checkbox" class="d-none" value="@item.Id" />
                                    </h6>
                                    @if (!string.IsNullOrWhiteSpace(item.Detail))
                                    {
                                        <p class="menu-meal-card-detail" title="@item.Detail">@item.Detail</p>
                                    }
                                </div>
                                <div class="menu-meal-card-actions">
                                    <span class="menu-meal-card-price">@currency @item.Price.ToString("0.00")</span>
                                    <span class="menu-add-btn" aria-hidden="true">
                                        <i class="ti ti-plus menu-add-icon"></i>
                                        <i class="ti ti-check menu-added-icon"></i>
                                        <span class="menu-add-label">Add</span>
                                        <span class="menu-added-label">Added</span>
                                    </span>
                                </div>
                            </div>

                            @if (nutritionStats.Count > 0 || item.IngredientNames.Count > 0)
                            {
                                <div class="menu-card-facts">
                                    @if (nutritionStats.Count > 0)
                                    {
                                        <div class="menu-nutrition-panel" data-count="@nutritionStats.Count" aria-label="Nutrition">
                                            @foreach (var stat in nutritionStats)
                                            {
                                                <div class="menu-nutrition-stat is-@stat.Key">
                                                    <span class="menu-nutrition-name">
                                                        @if (!string.IsNullOrEmpty(stat.Emoji))
                                                        {
                                                            <span class="menu-nutrition-emoji" aria-hidden="true">@stat.Emoji</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="@stat.IconClass" aria-hidden="true"></i>
                                                        }
                                                        <span class="menu-nutrition-label">@stat.Label</span>
                                                    </span>
                                                    <span class="menu-nutrition-amount">
                                                        <span class="menu-nutrition-value">@stat.Value</span>
                                                    </span>
                                                    <span class="menu-nutrition-unit">@stat.Unit</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (item.Ingredients.Count > 0)
                                    {
                                        var studentAllergens = new HashSet<string>(AlaCarteAllergenHelper.ParseAllergenList(item.StudentAllergies), StringComparer.OrdinalIgnoreCase);
                                        var orderedIngredients = item.Ingredients
                                            .OrderByDescending(ing => studentAllergens.Contains(ing.Name))
                                            .ToList();
                                        var maxIngredientChips = 6;
                                        var visibleIngredients = orderedIngredients.Take(maxIngredientChips).ToList();
                                        var extraIngredientCount = orderedIngredients.Count - visibleIngredients.Count;

                                        <div class="menu-ingredient-panel" aria-label="Ingredients">

                                            <div class="menu-ingredient-chips">
                                                <div class="menu-ingredient-label mb-0">
                                                    Allergen
                                                </div>
                                                @foreach (var ingredient in visibleIngredients)
                                                {
                                                    var isStudentAllergen = studentAllergens.Contains(ingredient.Name);
                                                    var iconFile = AlaCarteAllergenHelper.NormalizeIconFileName(ingredient.Icon);
                                                    <span class="menu-ingredient-chip@(isStudentAllergen ? " is-alert" : "")">
                                                        @if (!string.IsNullOrEmpty(iconFile))
                                                        {
                                                            <img class="menu-ingredient-icon" src="@Url.Content($"~/images/icons/{iconFile}")" alt="" />
                                                        }
                                                        @ingredient.Name
                                                    </span>
                                                }
                                                @if (extraIngredientCount > 0)
                                                {
                                                    <span class="menu-ingredient-more" title="@string.Join(", ", orderedIngredients.Skip(maxIngredientChips).Select(x => x.Name))">+@extraIngredientCount</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <input type="hidden" class="meal-item-date" value="@selectedMealDate" />
                        <input type="hidden" class="is-allergen-item" value="@(isAllergyItem ? "true" : "false")" />
                        <input type="hidden" class="allergies-name" value="@allergiesName" />
                        <input type="hidden" class="item-price" value="@item.Price" />
                    </article>
                }
            }
        </div>

        <div class="menu-filter-empty" id="menuFilterEmpty" hidden>
            <p class="text-muted mb-0">No meals match your search or filter.</p>
        </div>
    </div>
}
else
{
    <div class="menu-closed-day-card">
        <div class="menu-closed-day-state mb-5" data-closed-date="@ViewData["ClosedDate"]">
            <div class="menu-closed-day-illustration" aria-hidden="true">
                <div class="ala-carte-empty-icon">
                    <i class="ti ti-mood-empty"></i>
                </div>
            </div>
            <h2 class="menu-closed-day-title">No meals available</h2>
            <p class="menu-closed-day-message">
                <span>Try another date or child.</span>
            </p>
        </div>
    </div>
}
