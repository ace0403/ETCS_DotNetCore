@model PosLoginRequest
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Sign in - ETCS POS</title>
    <link rel="icon" href="~/favicon.ico" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <link rel="stylesheet" href="~/css/pos-login.css" asp-append-version="true" />
</head>
<body class="pos-login-page">
    <main class="pos-login-shell">
        <section class="pos-login-card" aria-labelledby="pos-login-title">
            <div class="pos-login-header">
                <img src="~/images/logo.png" alt="ETCS" class="pos-login-logo" width="140" />
                <h1 id="pos-login-title" class="pos-login-title">ETCS POS</h1>
                <p class="pos-login-subtitle">Sign in to continue</p>
            </div>

            <form asp-controller="Home" asp-action="Index" method="post" class="pos-login-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="pos-login-alert"></div>

                <div class="pos-login-field">
                    <label asp-for="Username" class="pos-login-label">Username</label>
                    <div class="pos-login-input-wrap pr-0">
                        <svg class="pos-login-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 12a4.5 4.5 0 100-9 4.5 4.5 0 000 9zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z" />
                        </svg>
                        <input asp-for="Username"
                               class="pos-login-input username"
                               placeholder="Enter your username"
                               autocomplete="username"
                               autofocus />
                    </div>
                    <span asp-validation-for="Username" class="pos-login-error"></span>
                </div>

                <div class="pos-login-field">
                    <label asp-for="Password" class="pos-login-label">Password</label>
                    <div class="pos-login-input-wrap">
                        <svg class="pos-login-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M17 9V7a5 5 0 10-10 0v2H5v12h14V9h-2zm-8 0V7a3 3 0 116 0v2H9zm2 5.7V17h2v-2.3a1.5 1.5 0 10-2 0z" />
                        </svg>
                        <input asp-for="Password"
                               id="loginPassword"
                               class="pos-login-input"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button"
                                class="pos-login-toggle"
                                id="btnTogglePassword"
                                aria-label="Show password"
                                title="Show password"
                                aria-pressed="false">
                            <svg class="pos-login-icon pos-login-icon--eye" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 5c5.2 0 9.5 3.4 10.8 7-1.3 3.6-5.6 7-10.8 7S2.5 15.6 1.2 12C2.5 8.4 6.8 5 12 5zm0 2c-3.9 0-7.2 2.5-8.5 5 1.3 2.5 4.6 5 8.5 5s7.2-2.5 8.5-5c-1.3-2.5-4.6-5-8.5-5zm0 2.5A2.5 2.5 0 1112 14.5 2.5 2.5 0 0112 9.5z" />
                            </svg>
                            <svg class="pos-login-icon pos-login-icon--eye-off" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3.3 2.3L2 3.6l3.1 3.1C3.4 8.1 2.1 9.9 1.2 12c1.3 3.6 5.6 7 10.8 7 2 0 3.9-.5 5.5-1.3l3.5 3.5 1.3-1.3L3.3 2.3zM12 17c-3.9 0-7.2-2.5-8.5-5 .7-1.4 1.9-2.8 3.4-3.8l1.6 1.6A2.5 2.5 0 0012 14.5c.4 0 .7-.1 1-.2l1.6 1.6c-.8.4-1.7.6-2.6.6zm8.5-5c-.4.9-1 1.8-1.7 2.5l-1.5-1.5c.4-.5.7-1.1.8-1.7C16.7 9.5 14.5 8 12 8c-.3 0-.6 0-.9.1L9.5 6.5C10.3 6.2 11.1 6 12 6c5.2 0 9.5 3.4 10.8 6-.4.9-.9 1.8-1.5 2.5l-.8-.8z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="pos-login-error"></span>
                </div>

                <button type="submit" class="pos-login-submit">
                    <span>Sign in</span>
                    <svg class="pos-login-icon pos-login-icon--submit" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M13.2 5.3l6.5 6.5-6.5 6.5-1.4-1.4 4.1-4.1H4v-2h11.9l-4.1-4.1 1.4-1.4z" />
                    </svg>
                </button>
            </form>

            <p class="pos-login-footer">&copy; @DateTime.Now.Year ETCS. All rights reserved.</p>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        (function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: 'toast-top-center',
                timeOut: 4500
            };

            var params = new URLSearchParams(window.location.search);
            var msg = (params.get('msg') || '').toLowerCase();
            if (msg === 'login-failed') {
                toastr.error('Invalid username or password.');
            } else if (msg === 'unauthorized-role') {
                toastr.error('This account is not authorized for POS.');
            } else if (msg === 'logout-success') {
                toastr.success('You have been signed out.');
            }

            $('#btnTogglePassword').on('click', function () {
                var $btn = $(this);
                var $input = $('#loginPassword');
                var showPlain = $input.attr('type') === 'password';
                $input.attr('type', showPlain ? 'text' : 'password');
                $btn.toggleClass('is-showing', showPlain);
                $btn.attr('aria-pressed', showPlain ? 'true' : 'false')
                    .attr('aria-label', showPlain ? 'Hide password' : 'Show password')
                    .attr('title', showPlain ? 'Hide password' : 'Show password');
            });
        })();
    </script>
</body>
</html>
