@model IReadOnlyList<PosCategoryDto>
@if (Model.Count == 0)
{
    <p class="pos-categories-placeholder">No categories available.</p>
}
else
{
    <div class="pos-pills" role="tablist" aria-label="Menu categories">
        <button type="button"
                class="pos-category-item is-active"
                data-category-id="0"
                role="tab"
                aria-selected="true">
            All
        </button>
        @foreach (var category in Model)
        {
            <button type="button"
                    class="pos-category-item"
                    data-category-id="@category.CategoryId"
                    role="tab"
                    aria-selected="false">
                @category.CategoryName
            </button>
        }
    </div>
}
