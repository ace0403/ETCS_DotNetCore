@model IReadOnlyList<PosTerminalDto>
@if (Model.Count == 0)
{
    <select id="ddlTerminal"><option value="">No terminals</option></select>
}
else
{
    <select id="ddlTerminal">
        @foreach (var terminal in Model)
        {
            <option value="@terminal.TerminalCode" data-ip-address="@terminal.IpAddress" data-terminal-numeric="@terminal.TerminalCodeNumeric" data-branch-code="@terminal.BranchCode">
                @terminal.TerminalName (@terminal.TerminalCode)
            </option>
        }
    </select>
}
