@using ETCS.Shared.Infrastructure.Admin.Master.Schools
@{
    ViewData["Title"] = "In-App Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <div class="admin-grid-actions">
                <a asp-action="Broadcast" class="btn btn-primary btn-sm"><i class="ti ti-send"></i> Broadcast</a>
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
            <table id="inapp_notification_table" class="table table-striped table-bordered w-100" style="width:100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Guardian</th>
                        <th>School</th>
                        @* <th>Type</th> *@
                        <th>Title</th>
                        <th>Message</th>
                        <th>Read</th>
                        <th>Created By</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/custom/inapp-notification-log.js"></script> }
