@model ETCS.Admin.Controllers.InAppNotificationBroadcastRequest
@using ETCS.Shared.Infrastructure.Admin.Master.Schools
@using ETCS.Shared.Infrastructure.Notifications
@{
    ViewData["Title"] = "Broadcast Notification";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var schools = ViewBag.Schools as IReadOnlyList<SchoolListItemDto> ?? Array.Empty<SchoolListItemDto>();
}
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <div class="admin-grid-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left"></i> Log</a>
            </div>
        </div>
        <form id="broadcastForm" class="row g-3">
            <div class="col-md-6">
                <label asp-for="SchoolId" class="form-label"></label>
                <select asp-for="SchoolId" class="form-select">
                    <option value="0">Select school</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id">@school.Name (@school.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="GuardianId" class="form-label"></label>
                <input asp-for="GuardianId" class="form-control" placeholder="Leave blank to notify all guardians in school" />
                <div class="form-text">If set, only this guardian receives the notification.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label">Type</label>
                <select asp-for="Type" class="form-select">
                    <option value="@GuardianNotificationTypes.Announcement">Announcement</option>
                    <option value="@GuardianNotificationTypes.System">System</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="200" />
            </div>
            <div class="col-12">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" class="form-control" rows="4" maxlength="1000"></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary" id="btnBroadcast">Send Notification</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script>
    $('#broadcastForm').on('submit', function (e) {
        e.preventDefault();
        var $btn = $('#btnBroadcast').prop('disabled', true);
        $.post('@Url.Action("SendBroadcast")', $(this).serialize())
            .done(function (res) {
                if (res.success || res.Success) {
                    toastr.success(res.message || res.Message || 'Sent');
                    setTimeout(function () { window.location = '@Url.Action("Index")'; }, 800);
                } else {
                    toastr.error(res.message || res.Message || 'Failed');
                    $btn.prop('disabled', false);
                }
            })
            .fail(function () {
                toastr.error('Failed to send notification.');
                $btn.prop('disabled', false);
            });
    });
</script>
}
