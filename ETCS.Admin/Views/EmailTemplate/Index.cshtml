@{
    ViewData["Title"] = "Email Templates";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AdminModuleKey = "EmailTemplate";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="mb-0">Email Templates</h2>
    <a asp-action="Log" class="btn btn-outline-secondary btn-sm"><i class="ti ti-mail"></i> Notification Log</a>
</div>
<div class="card">
    <div class="card-body">
        <p class="text-muted mb-3">Manage guardian notification emails for top-up, ala-carte, and meal combo order success.</p>
        <div class="table-responsive admin-grid-table-scroll">
        <table id="grid_table" class="table table-striped table-bordered w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Template Key</th>
                    <th>Subject</th>
                    <th>Active</th>
                    <th>Last Updated</th>
                    <th class="text-center" style="width:70px"></th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>
<div class="modal fade" id="addDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="div_add"></div>
    </div>
</div>
@section Scripts {
    <script>window.adminModuleKey = 'EmailTemplate';</script>
    <script src="~/js/custom/emailtemplate.js"></script>
}
