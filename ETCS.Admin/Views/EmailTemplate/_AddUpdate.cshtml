@model ETCS.Shared.Infrastructure.Email.EmailTemplateDetailDto
@{
    Layout = null;
    var placeholders = new[]
    {
        "{{GuardianName}}", "{{StudentName}}", "{{OrderId}}", "{{TransactionId}}", "{{Amount}}", "{{EventDate}}", "{{OrderItems}}",
        "{{LogoUrl}}", "{{OtpCode}}", "{{ResetLink}}", "{{ExpiryMinutes}}", "{{AddChildLink}}",
        "{{CardNumber}}", "{{CustomerId}}", "{{Reason}}", "{{RefCode}}", "{{SchoolName}}"
    };
}
<form id="frmEmailTemplate">
    <div class="modal-header">
        <h5 class="modal-title">Edit Email Template</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="TemplateKey" />
        <div class="mb-3">
            <span class="badge bg-primary fs-6">@Model.TemplateKey</span>
        </div>
        <div class="mb-3">
            <label asp-for="SubjectTemplate" class="form-label">Subject</label>
            <input asp-for="SubjectTemplate" class="form-control" id="emailSubject" />
        </div>
        <div class="mb-3">
            <label asp-for="RecipientEmail" class="form-label">Recipient email</label>
            <input asp-for="RecipientEmail" class="form-control" type="email" maxlength="256" placeholder="Leave empty to send to the guardian" />
            <div class="form-text">When set, this template always sends here instead of the guardian.</div>
        </div>
        <div class="mb-2">
            <label class="form-label">Placeholders</label>
            <div class="d-flex flex-wrap gap-2" id="placeholderChips">
                @foreach (var ph in placeholders)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary email-placeholder-chip" data-placeholder="@ph">@ph</button>
                }
            </div>
        </div>
        <div class="row g-3">
            <div class="col-lg-7">
                <label asp-for="BodyHtmlTemplate" class="form-label">Email Body (HTML)</label>
                <textarea asp-for="BodyHtmlTemplate" id="emailBodyEditor" class="form-control" rows="18"></textarea>
            </div>
            <div class="col-lg-5">
                <label class="form-label">Live Preview</label>
                <div class="border rounded bg-white p-2" style="min-height:420px;max-height:520px;overflow:auto;">
                    <iframe id="emailPreviewFrame" title="Email preview" class="w-100 border-0" style="min-height:400px;"></iframe>
                </div>
            </div>
        </div>
        <div class="form-check form-switch mt-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
