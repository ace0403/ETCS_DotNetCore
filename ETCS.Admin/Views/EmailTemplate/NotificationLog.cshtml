@{
    ViewData["Title"] = "Email Notification Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <div class="admin-grid-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left"></i> Templates</a>
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
        <table id="log_table" class="table table-striped table-bordered w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Template</th>
                    <th>To</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Error</th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/custom/emailnotificationlog.js"></script> }
