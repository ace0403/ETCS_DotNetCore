@{
    ViewData["Title"] = "Menu Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AdminModuleKey = "Category";
}
<div class="page-header d-flex justify-content-between">
    <h2>Menu Type / Categories</h2>
    <partial name="_AdminAddButton" />
</div>
<div class="card">
    <div class="card-body">
        <partial name="_AdminGridSearch" />
        <div class="table-responsive admin-grid-table-scroll">
        <table id="grid_table" class="table table-striped table-bordered w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Sort Order</th>
                    <th>Active</th>
                    <th class="text-center" style="width:70px"></th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>
<div class="modal fade" id="addDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="div_add"></div>
    </div>
</div>
@section Scripts {
    <script>window.adminModuleKey = 'Category';</script>
    <script src="~/js/custom/category.js"></script>
}
