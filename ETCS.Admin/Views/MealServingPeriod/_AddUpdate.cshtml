@model ETCS.Shared.Infrastructure.Admin.Inventory.MealServingPeriods.MealServingPeriodSaveRequest
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@{
    Layout = null;
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? [];
    string FormatDateOnly(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd") : string.Empty;
}
<form id="frmMealServingPeriod">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id > 0 ? "Edit" : "Add") Serving Period</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="SchoolId" class="form-label">School</label>
                <select asp-for="SchoolId" class="form-select">
                    <option value="">- Select school -</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id">@school.Name</option>
                    }
                </select>
                <span asp-validation-for="SchoolId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" type="date" value="@FormatDateOnly(Model.StartDate)" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="CutoffDate" class="form-label"></label>
                <input asp-for="CutoffDate" class="form-control" type="date" value="@FormatDateOnly(Model.CutoffDate)" />
                <span asp-validation-for="CutoffDate" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
    </div>
</form>
