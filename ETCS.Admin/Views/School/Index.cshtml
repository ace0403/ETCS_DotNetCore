@model ETCS.Shared.Infrastructure.Admin.Master.Schools.SchoolSaveRequest
@using ETCS.Admin.Infrastructure.Auth
@{
    ViewData["Title"] = "Manage Schools";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AdminModuleKey = "School";
}
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <partial name="_AdminGridSearch" />
            <div class="admin-grid-actions">
                <partial name="_AdminAddButton" />
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
        <table id="grid_table" class="table table-striped table-bordered nowrap w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Country</th>
                    <th>Min Topup</th>
                    <th>Email Alerts</th>
                    <th class="text-center" style="width:70px"></th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>
<div class="modal fade" id="addDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="div_add"></div>
    </div>
</div>
@section Scripts {
    <link href="~/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/js/bootstrap-multiselect.js"></script>
    <script>window.adminModuleKey = 'School';</script>
    <script src="~/js/custom/school.js"></script>
}
