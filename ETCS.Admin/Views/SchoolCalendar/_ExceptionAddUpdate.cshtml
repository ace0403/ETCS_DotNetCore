@model ETCS.Shared.Infrastructure.Schools.Calendar.SchoolCalendarExceptionSaveRequest
@using ETCS.Shared.Enumeration
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@{
    Layout = null;
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? [];
    string FormatDateOnly(DateTime value) => value.ToString("yyyy-MM-dd");
}
<form id="frmSchoolCalendarException">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id > 0 ? "Edit" : "Add") holiday</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="SchoolId" class="form-label">School</label>
                <select asp-for="SchoolId" class="form-select">
                    <option value="">- Select school -</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id">@school.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ExceptionDate" class="form-label">Date</label>
                <input asp-for="ExceptionDate" class="form-control" type="date" value="@FormatDateOnly(Model.ExceptionDate)" />
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="DayStatus" class="form-label">Status</label>
                <select asp-for="DayStatus" class="form-select">
                    <option value="@((byte)SchoolDayStatus.Holiday)">Holiday</option>
                    <option value="@((byte)SchoolDayStatus.HalfDay)">Half day</option>
                    <option value="@((byte)SchoolDayStatus.FullDay)">Full day (override)</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" maxlength="100" placeholder="e.g. Eid Al-Fitr, National Day" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
    </div>
</form>
