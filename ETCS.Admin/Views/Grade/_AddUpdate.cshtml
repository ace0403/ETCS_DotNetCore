@model ETCS.Shared.Infrastructure.Admin.Master.Grades.GradeSaveRequest
@{
    Layout = null;
}
<form id="frmGrade">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id > 0 ? "Edit" : "Add") Grade</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Grade" class="form-label"></label>
                <input asp-for="Grade" class="form-control" placeholder="Grade" maxlength="50" />
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
    </div>
</form>
