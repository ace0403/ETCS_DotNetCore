@model ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffSaveRequest
@{
    Layout = null;
    var roles = ViewBag.Roles as IReadOnlyList<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffRoleLookupDto> ?? Array.Empty<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffRoleLookupDto>();
    var countries = ViewBag.Countries as IReadOnlyList<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffCountryLookupDto> ?? Array.Empty<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffCountryLookupDto>();
    var schools = ViewBag.Schools as IReadOnlyList<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffSchoolLookupDto> ?? Array.Empty<ETCS.Shared.Infrastructure.Admin.Master.Staff.StaffSchoolLookupDto>();
    var dobValue = Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "";
    var selectedSchoolIds = Model.SchoolIds ?? [];
    var selectedRoleId = Model.RoleId > 0
        ? Model.RoleId
        : (Model.DefaultRoleId ?? Model.RoleIds.FirstOrDefault());
}
<form id="frmStaff">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add" : "Edit") Staff Member</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsNew" />
        <input type="hidden" id="hdnSelectedSchoolIds" value="@string.Join(",", selectedSchoolIds)" />
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="LoginName" class="form-label"></label>
                <input asp-for="LoginName" class="form-control" placeholder="Username" readonly="@(!Model.IsNew)" />
                <span asp-validation-for="LoginName" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="@(Model.IsNew ? "Password" : "Leave blank to keep")" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" placeholder="Firstname" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" placeholder="Lastname" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="StaffId" class="form-label"></label>
                <input asp-for="StaffId" class="form-control" placeholder="Staff ID" />
                <span asp-validation-for="StaffId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" value="@dobValue" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="CountryId" class="form-label"></label>
                <select asp-for="CountryId" id="ddlStaffCountry" class="form-select">
                    <option value="">- Select -</option>
                    @foreach (var country in countries)
                    {
                        <option value="@country.Id">@country.Name</option>
                    }
                </select>
                <span asp-validation-for="CountryId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 multiselect-custom">
                <label asp-for="SchoolIds" class="form-label"></label>
                <select asp-for="SchoolIds" id="ddlStaffSchool" class="form-select ignore-validation" multiple data-val="false">
                    @foreach (var school in schools)
                    {
                        if (selectedSchoolIds.Contains(school.Id))
                        {
                            <option value="@school.Id" selected="selected">@school.Name</option>
                        }
                        else
                        {
                            <option value="@school.Id">@school.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="SchoolIds" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="RoleId" class="form-label"></label>
                <select asp-for="RoleId" id="ddlStaffRole" class="form-select">
                    <option value="">- Select -</option>
                    @foreach (var role in roles)
                    {
                        if (selectedRoleId == role.Id)
                        {
                            <option value="@role.Id" selected="selected">@role.Name</option>
                        }
                        else
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="SecurityQuestion" class="form-label"></label>
                <input asp-for="SecurityQuestion" class="form-control" placeholder="Security Question" />
                <span asp-validation-for="SecurityQuestion" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="SecurityAnswer" class="form-label"></label>
                <input asp-for="SecurityAnswer" class="form-control" placeholder="Security Answer" />
                <span asp-validation-for="SecurityAnswer" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
    </div>
</form>
