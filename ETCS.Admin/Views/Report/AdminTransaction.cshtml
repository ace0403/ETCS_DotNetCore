@using ETCS.Shared.Infrastructure.Admin.Reports.CanteenTransactions
@{
    ViewData["Title"] = "Report on Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var schools = ViewBag.Schools as IReadOnlyList<SchoolCodeLookupDto> ?? Array.Empty<SchoolCodeLookupDto>();
    var startDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    var endDate = DateTime.Today.ToString("yyyy-MM-dd");
    var reportError = TempData["ReportError"] as string;
}
<div class="page-header">
    <h2 class="mb-0">Report on Transactions</h2>
</div>

@if (!string.IsNullOrWhiteSpace(reportError))
{
    <div class="alert alert-warning">@reportError</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4">
                <label for="txtStartDate" class="form-label">Start date</label>
                <input type="date" id="txtStartDate" class="form-control" value="@startDate" />
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="txtEndDate" class="form-label">End date</label>
                <input type="date" id="txtEndDate" class="form-control" value="@endDate" />
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="ddlSchool" class="form-label">School</label>
                <select id="ddlSchool" class="form-select">
                    <option value="">All Schools</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Code" title="@school.Name">@school.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="ddlTerminal" class="form-label">Terminal</label>
                <select id="ddlTerminal" class="form-select canteen-branch-select" title="All Terminals">
                    <option value="">All Terminals</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="ddlTransactionType" class="form-label">Transaction Type</label>
                <select id="ddlTransactionType" class="form-select">
                    <option value="">ALL</option>
                    <option value="1004">Cash Purchase</option>
                    <option value="2004">Credit Card Purchase</option>
                    <option value="21002">Card_Purchase</option>
                    <option value="10001">Online Topup</option>
                    <option value="21004">Topup</option>
                    <option value="21006">Undo Purchase_Card</option>
                    <option value="21007">Undo Topup</option>
                    <option value="1007">Undo Cash Purchase</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="txtStudCode" class="form-label">Student Card No</label>
                <input type="text" id="txtStudCode" class="form-control" placeholder="Student Card No" maxlength="50" />
            </div>
            <div class="col-12">
                <div class="text-muted small mb-2">Use transaction filters or student card no.</div>
                <button type="button" class="btn btn-primary" id="btnViewReport">
                    <span class="btn-label">View Report</span>
                    <span class="btn-spinner spinner-border spinner-border-sm ms-1 d-none" role="status" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-outline-primary" id="btnExportReport">Export Report</button>
            </div>
        </div>
    </div>
</div>

<form id="frmExport" asp-controller="Report" asp-action="ExportAdminTransactions" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="StartDate" id="exportStartDate" />
    <input type="hidden" name="EndDate" id="exportEndDate" />
    <input type="hidden" name="SchoolCode" id="exportSchoolCode" />
    <input type="hidden" name="TerminalCode" id="exportTerminalCode" />
    <input type="hidden" name="TransactionType" id="exportTransactionType" />
    <input type="hidden" name="StudentCardNo" id="exportStudentCardNo" />
</form>

<div id="adminTxnReportLoader" class="canteen-report-screen-loader d-none" aria-live="polite" aria-busy="true">
    <div class="canteen-report-loader-card">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="canteen-report-loader-text">Loading report...</span>
    </div>
</div>

<div class="card canteen-report-card">
    <div class="card-body">
        <div id="reportEmptyMessage" class="text-muted mb-2">Click View Report to load data.</div>
        <div id="adminTxnReportGridWrap" class="canteen-report-grid-wrap">
            <div class="table-responsive canteen-report-table-scroll">
                <table id="grid_table" class="table table-striped table-bordered canteen-report-table">
                    <thead>
                        <tr>
                            <th>S No</th>
                            <th>Date</th>
                            <th>Student Id</th>
                            <th>Name</th>
                            <th>Class</th>
                            <th>Amount</th>
                            <th>VAT</th>
                            <th>Terminal</th>
                            <th>Transaction Type</th>
                            <th>Transaction Id</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/custom/admin-transaction-report.js"></script>
}
