@using ETCS.Admin.Infrastructure.Auth
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@{
    ViewData["Title"] = "Student Consumption";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var startMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM");
    var endMonth = DateTime.Today.ToString("yyyy-MM");
    var reportError = TempData["ReportError"] as string;
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? Array.Empty<SchoolLookupDto>();
    var isScoped = User.IsSchoolScoped() && !User.IsAdminRole();
    var selectedSchoolId = isScoped && schools.Count == 1 ? schools[0].Id : 0;
}



@if (!string.IsNullOrWhiteSpace(reportError))

{

    <div class="alert alert-warning">@reportError</div>

}



<div class="card mb-3">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-12 col-md-6 col-lg-4">

                <label for="txtStartDate" class="form-label">From (mm/yyyy)</label>

                <input type="month" id="txtStartDate" class="form-control" value="@startMonth" />

            </div>

            <div class="col-12 col-md-6 col-lg-4">

                <label for="txtEndDate" class="form-label">To (mm/yyyy)</label>

                <input type="month" id="txtEndDate" class="form-control" value="@endMonth" />

            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <label for="ddlSchool" class="form-label">School</label>
                <select id="ddlSchool" class="form-select" @(isScoped && schools.Count == 1 ? "disabled" : "")>
                    <option value="">- Select School -</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id" selected="@(selectedSchoolId == school.Id)">@school.Name</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-4">

                <label for="ddlStudent" class="form-label">Student <span class="text-muted">(optional)</span></label>

                <div class="student-consumption-select-wrap">

                    <select id="ddlStudent" class="js-student-consumption-select">

                        <option value="">All Students</option>

                    </select>

                </div>

            </div>

            <div class="col-12">

                <button type="button" class="btn btn-primary" id="btnViewReport">

                    <span class="btn-label">View Report</span>

                    <span class="btn-spinner spinner-border spinner-border-sm ms-1 d-none" role="status" aria-hidden="true"></span>

                </button>

                <button type="button" class="btn btn-outline-primary" id="btnExportReport">Export Report</button>

            </div>

        </div>

    </div>

</div>



<form id="frmExport" asp-controller="Report" asp-action="ExportStudentConsumption" method="post" class="d-none">

    @Html.AntiForgeryToken()

    <input type="hidden" name="StartDate" id="exportStartDate" />

    <input type="hidden" name="EndDate" id="exportEndDate" />

    <input type="hidden" name="SchoolId" id="exportSchoolId" />
    <input type="hidden" name="StudentUserId" id="exportStudentUserId" />

</form>



<div id="studentConsumptionReportLoader" class="canteen-report-screen-loader d-none" aria-live="polite" aria-busy="true">

    <div class="canteen-report-loader-card">

        <div class="spinner-border text-primary" role="status">

            <span class="visually-hidden">Loading...</span>

        </div>

        <span class="canteen-report-loader-text">Loading report...</span>

    </div>

</div>



<div class="card canteen-report-card">

    <div class="card-body">

        <div id="reportEmptyMessage" class="text-muted mb-2">Select from/to month and school, then click View Report.</div>

        <div id="studentConsumptionReportGridWrap" class="canteen-report-grid-wrap">

            <div class="table-responsive canteen-report-table-scroll">

                <table id="grid_table" class="table table-striped table-bordered canteen-report-table">

                    <thead>

                        <tr>

                            <th>Student Name</th>

                            <th>Code</th>

                            <th>Customer Details</th>

                            <th>Trans Date</th>

                            <th class="text-end">Debit</th>

                            <th class="text-end">Credit</th>

                            <th class="text-end">Amount</th>

                        </tr>

                    </thead>

                </table>

            </div>

        </div>

        <div id="studentConsumptionPager" class="student-consumption-pager d-none d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
            <div id="studentConsumptionPageInfo" class="text-muted small"></div>
            <div class="d-flex align-items-center gap-2">
                <select id="ddlStudentPageSize" class="form-select form-select-sm student-consumption-page-size">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnStudentPagePrev">Previous</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnStudentPageNext">Next</button>
            </div>
        </div>

    </div>

</div>



@section Styles {

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

}



@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/js/custom/student-consumption-report.js"></script>

}


