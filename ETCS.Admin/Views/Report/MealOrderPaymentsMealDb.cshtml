@using ETCS.Shared.Infrastructure.Admin.Reports.MealOrderPayments
@{
    ViewData["Title"] = "Meal Order Payment Report (NEW)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var schools = ViewBag.Schools as IReadOnlyList<MealOrderPaymentSchoolLookupDto> ?? Array.Empty<MealOrderPaymentSchoolLookupDto>();
    var startDate = ViewBag.MealOrderPaymentStartDate as string ?? DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    var endDate = ViewBag.MealOrderPaymentEndDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var minDate = ViewBag.MealOrderPaymentMinDate as string;
    var reportError = TempData["ReportError"] as string;
}

@if (!string.IsNullOrWhiteSpace(reportError))
{
    <div class="alert alert-warning">@reportError</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-3 col-lg-4">
                <label for="txtStartDate" class="form-label">Start date</label>
                <input type="date" id="txtStartDate" class="form-control" value="@startDate" min="@minDate" />
            </div>
            <div class="col-12 col-md-3 col-lg-4">
                <label for="txtEndDate" class="form-label">End date</label>
                <input type="date" id="txtEndDate" class="form-control" value="@endDate" min="@minDate" />
            </div>
            <partial name="_ScopedMealSchoolFilter" />
            <div class="col-12 col-md-6 col-lg-4">
                <label for="txtTransactionId" class="form-label">Transaction Id</label>
                <input type="text" id="txtTransactionId" class="form-control" placeholder="Transaction Id" maxlength="100" />
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-primary" id="btnViewReport">
                    <span class="btn-label">View Report</span>
                    <span class="btn-spinner spinner-border spinner-border-sm ms-1 d-none" role="status" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-outline-primary" id="btnExportReport">Export Report</button>
            </div>
        </div>
    </div>
</div>

<form id="frmExport" asp-controller="Report" asp-action="ExportMealOrderPaymentsMealDb" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="StartDate" id="exportStartDate" />
    <input type="hidden" name="EndDate" id="exportEndDate" />
    <input type="hidden" name="SchoolId" id="exportSchoolId" />
    <input type="hidden" name="TransactionId" id="exportTransactionId" />
</form>

<div id="mealOrderReportLoader" class="canteen-report-screen-loader d-none" aria-live="polite" aria-busy="true">
    <div class="canteen-report-loader-card">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="canteen-report-loader-text">Loading report...</span>
    </div>
</div>

<div class="card canteen-report-card">
    <div class="card-body">
        <div id="reportEmptyMessage" class="text-muted mb-2">Click View Report to load data.</div>
        <div id="mealOrderReportGridWrap" class="canteen-report-grid-wrap">
            <div class="table-responsive canteen-report-table-scroll">
                <table id="grid_table" class="table table-striped table-bordered canteen-report-table">
                    <thead>
                        <tr>
                            <th>S No</th>
                            <th>Transaction Date</th>
                            <th>Student Card No.</th>
                            <th>Student Name</th>
                            <th>Grade</th>
                            <th>Transaction Id</th>
                            <th>Transaction Type</th>
                            <th>Package</th>
                            <th>Amount</th>
                            <th>School Name</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/custom/meal-order-payment-mealdb-report.js"></script>
}
