@using ETCS.Admin.Infrastructure.Auth
@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ETCS Admin</title>
    <link rel="stylesheet" href="~/fonts/inter/inter.css" />
    <link rel="stylesheet" href="~/fonts/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/fonts/feather.css" />
    <link rel="stylesheet" href="~/fonts/fontawesome.css" />
    <link rel="stylesheet" href="~/fonts/material.css" />
    <link href="~/css/sweetalert2.bundle.css" rel="stylesheet" />
    <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" />
    <link href="~/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/style-preset.css" />
    <link rel="stylesheet" href="~/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/custom/dev-style.css" />
    <link rel="stylesheet" href="~/css/custom/portal-theme.css" asp-append-version="true" />
</head>
<body data-pc-preset="preset-1" data-pc-sidebar-caption="true" data-pc-direction="ltr" data-pc-theme="light">
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    <partial name="_Sidebar" />
    <partial name="_Header" />
    <div class="pc-container">
        <div class="pc-content pt-4 pt-lg-4 pt-xl-1">
            @RenderBody()
        </div>
    </div>
    <footer class="pc-footer">
        <div class="footer-wrapper container-fluid">
            <div class="row">
                <div class="col my-1">
                    <p class="m-0">© @DateTime.Now.Year ETCS. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/plugins/popper.min.js"></script>
    <script src="~/js/plugins/simplebar.min.js"></script>
    <script src="~/js/plugins/bootstrap.min.js"></script>
    <script src="~/js/fonts/custom-font.js"></script>
    <script src="~/js/pcoded.js"></script>
    <script src="~/js/plugins/feather.min.js"></script>
    <script src="~/js/toastr.min.js"></script>
    <script src="~/js/sweetalert2.bundle.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/datatables.bootstrap5.min.js"></script>
    <script src="~/js/custom/siteurl.js"></script>
    <script src="~/js/custom/common.js"></script>
    <script src="~/js/custom/admin-datatable.js"></script>
    <script>
        window.adminPermissions = @Html.Raw(AdminPermissionScriptBuilder.BuildPermissionsJson(User));
        window.adminSchoolScope = @Html.Raw(AdminPermissionScriptBuilder.BuildSchoolScopeJson(User));
        window.adminIsFullAccess = @(User.IsAdminRole().ToString().ToLower());
        layout_change('light');
        preset_change("preset-1");

        // Sidebar uses native CSS scroll (portal-theme). Skip Able Pro SimpleBar on the menu —
        // it often mounts without a constrained height and blocks scrolling.
        window.add_scroller = function () {
            if (typeof menu_click === 'function') {
                menu_click();
            }
            var el = document.querySelector('.pc-sidebar .navbar-content');
            if (!el) return;
            try {
                if (el.SimpleBar && typeof el.SimpleBar.unMount === 'function') {
                    el.SimpleBar.unMount();
                }
            } catch (e) { /* ignore */ }
            el.removeAttribute('data-simplebar');
            el.classList.remove('simplebar-scrollable-y', 'simplebar-scrollable-x');
            el.style.overflowY = 'auto';
            el.style.overflowX = 'hidden';

            if (el.dataset.autoHideScrollBound !== '1') {
                el.dataset.autoHideScrollBound = '1';
                var hideTimer;
                el.addEventListener('scroll', function () {
                    el.classList.add('is-scrolling');
                    clearTimeout(hideTimer);
                    hideTimer = setTimeout(function () {
                        el.classList.remove('is-scrolling');
                    }, 900);
                }, { passive: true });
            }

            scrollActiveSidebarItemIntoView(el);
        };

        function scrollActiveSidebarItemIntoView(nav) {
            nav = nav || document.querySelector('.pc-sidebar .navbar-content');
            if (!nav) return;
            var active = nav.querySelector('.pc-navbar > .pc-item.active:not(.pc-caption)');
            if (!active) return;

            var navRect = nav.getBoundingClientRect();
            var itemRect = active.getBoundingClientRect();
            var fullyVisible = itemRect.top >= navRect.top + 4 && itemRect.bottom <= navRect.bottom - 4;
            if (fullyVisible) return;

            // Briefly reveal the auto-hide scrollbar while we jump to the active item.
            nav.classList.add('is-scrolling');
            active.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'smooth' });
            setTimeout(function () {
                nav.classList.remove('is-scrolling');
            }, 1000);
        }

        if (document.readyState !== 'loading') {
            setTimeout(window.add_scroller, 0);
        }
        window.addEventListener('load', function () { setTimeout(window.add_scroller, 0); });

        $(function () {
            $('#btnChangePassword').on('click', function (e) {
                e.preventDefault();
                $.get(SiteUrl + 'home/changepasswordmodal', function (html) {
                    $('#changePasswordContainer').html(html);
                    $('#changePasswordModal').modal('show');
                });
            });
        });
    </script>
    <partial name="_CommonMessages" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
