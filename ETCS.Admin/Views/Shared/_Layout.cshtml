@using ETCS.Admin.Infrastructure.Auth
@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ETCS Admin</title>
    <link rel="stylesheet" href="~/fonts/inter/inter.css" />
    <link rel="stylesheet" href="~/fonts/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/fonts/feather.css" />
    <link rel="stylesheet" href="~/fonts/fontawesome.css" />
    <link rel="stylesheet" href="~/fonts/material.css" />
    <link href="~/css/sweetalert2.bundle.css" rel="stylesheet" />
    <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" />
    <link href="~/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/style-preset.css" />
    <link rel="stylesheet" href="~/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/custom/dev-style.css" />
</head>
<body data-pc-preset="preset-1" data-pc-sidebar-caption="true" data-pc-direction="ltr" data-pc-theme="light">
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    <partial name="_Sidebar" />
    <partial name="_Header" />
    <div class="pc-container">
        <div class="pc-content pt-1">
            @RenderBody()
        </div>
    </div>
    <footer class="pc-footer">
        <div class="footer-wrapper container-fluid">
            <div class="row">
                <div class="col my-1">
                    <p class="m-0">© @DateTime.Now.Year ETCS. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/plugins/popper.min.js"></script>
    <script src="~/js/plugins/simplebar.min.js"></script>
    <script src="~/js/plugins/bootstrap.min.js"></script>
    <script src="~/js/fonts/custom-font.js"></script>
    <script src="~/js/pcoded.js"></script>
    <script src="~/js/plugins/feather.min.js"></script>
    <script src="~/js/toastr.min.js"></script>
    <script src="~/js/sweetalert2.bundle.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/datatables.bootstrap5.min.js"></script>
    <script src="~/js/custom/siteurl.js"></script>
    <script src="~/js/custom/common.js"></script>
    <script src="~/js/custom/admin-datatable.js"></script>
    <script>
        window.adminPermissions = @Html.Raw(AdminPermissionScriptBuilder.BuildPermissionsJson(User));
        window.adminSchoolScope = @Html.Raw(AdminPermissionScriptBuilder.BuildSchoolScopeJson(User));
        window.adminIsFullAccess = @(User.IsAdminRole().ToString().ToLower());
        layout_change('light');
        preset_change("preset-1");

        $(function () {
            $('#btnChangePassword').on('click', function (e) {
                e.preventDefault();
                $.get(SiteUrl + 'home/changepasswordmodal', function (html) {
                    $('#changePasswordContainer').html(html);
                    $('#changePasswordModal').modal('show');
                });
            });
        });
    </script>
    <partial name="_CommonMessages" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
