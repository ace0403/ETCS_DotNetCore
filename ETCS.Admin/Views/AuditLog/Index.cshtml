@{
    ViewData["Title"] = "Audit Log";
    ViewData["PageSubtitle"] = "Search who changed what, and when.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-body">
        <div class="audit-log-filters mb-3">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label" for="auditFrom">From</label>
                    <input type="date" id="auditFrom" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="auditTo">To</label>
                    <input type="date" id="auditTo" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="auditSourceApp">App</label>
                    <select id="auditSourceApp" class="form-select">
                        <option value="">All</option>
                        <option value="Admin">Admin</option>
                        <option value="Web">Web</option>
                        <option value="Api">Api</option>
                        <option value="Pos">Pos</option>
                        <option value="System">System</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="auditActor">Actor</label>
                    <input type="text" id="auditActor" class="form-control form-control-sm" placeholder="Name or id" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="auditAction">Action</label>
                    <input type="text" id="auditAction" class="form-control form-control-sm" placeholder="Create, Login..." />
                </div>
            </div>
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label" for="auditOutcome">Outcome</label>
                    <select id="auditOutcome" class="form-select">
                        <option value="">All</option>
                        <option value="Success">Success</option>
                        <option value="Failure">Failure</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="auditEntityType">Entity</label>
                    <input type="text" id="auditEntityType" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="auditEntityId">Entity id</label>
                    <input type="text" id="auditEntityId" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="auditCorrelationId">Correlation id</label>
                    <input type="text" id="auditCorrelationId" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="button" id="auditApply" class="btn btn-primary">Apply</button>
                        <button type="button" id="auditClear" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
            <table id="audit_table" class="table table-striped table-bordered w-100" style="width:100%">
                <thead>
                    <tr>
                        <th>When (UTC)</th>
                        <th>App</th>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity id</th>
                        <th>Outcome</th>
                        <th>Message</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="auditDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Audit detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-3" id="auditDetailMeta"></dl>
                <div id="auditValues"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/custom/auditlog.js"></script> }
