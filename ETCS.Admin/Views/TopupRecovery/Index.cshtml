@using ETCS.Admin.Infrastructure.Payments
@model IReadOnlyList<V1TopupRecoveryRow>
@{
    ViewData["Title"] = "Top-up recovery";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var filter = (V1TopupRecoveryFilter)ViewBag.Filter;
    bool canRetry = ViewBag.CanRetry;
    bool enabled = ViewBag.RecoveryEnabled;
    bool hasMore = ViewBag.HasMore;
    var nextId = Model.LastOrDefault()?.Id ?? 0;
}
<div class="card mb-3">
    <div class="card-body">
        <h4>Top-up recovery</h4>
        <p>Check existing hosted-checkout payments and retry wallet credits. A retry uses the original payment;
            it does not create a new checkout. Only verified payments can be credited.</p>
        @if (!enabled)
        {
            <div class="alert alert-warning">Recovery is not enabled or its gateway settings are missing. You can still review the list.</div>
        }
        @if (!canRetry)
        {
            <div class="alert alert-info">Your access allows viewing. Transaction report Edit permission is required to retry.</div>
        }
        <form method="get" id="recovery-filter" class="row g-3">
            <div class="col-md-3">
                <label for="from" class="form-label">Request date from</label>
                <input class="form-control" type="date" id="from" name="From" value="@filter.From.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3">
                <label for="to" class="form-label">Request date to</label>
                <input class="form-control" type="date" id="to" name="To" value="@filter.To.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-4">
                <label for="reference" class="form-label">Order or gateway reference</label>
                <input class="form-control" id="reference" name="Reference" maxlength="100" value="@filter.Reference" />
            </div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Search</button></div>
            <div class="col-12">
                <label><input type="checkbox" name="IncludeCompleted" value="true" checked="@filter.IncludeCompleted" /> Include completed payments</label>
                <div class="text-muted small">Dates use the original request's database server time. Up to 50 payments are shown per page.
                    Web-sourced payments and existing wallet entries that need review are identified below.</div>
            </div>
        </form>
    </div>
</div>
<form id="recovery-retry" action="@Url.Action("Retry")" method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">
            @if (canRetry && enabled)
            {
                <button type="button" id="retry-selected" class="btn btn-primary mb-3">Retry selected</button>
            }
            <div id="recovery-progress" class="mb-3" role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr>
                        <th><input type="checkbox" id="select-all" aria-label="Select eligible payments on this page" disabled="@(!canRetry || !enabled)" /></th>
                        <th>Request / student</th><th>Original references</th><th>Amount (AED)</th>
                        <th>Source / state</th><th>Wallet entry</th><th>Last scheduled check (UTC)</th><th>Recovery result</th><th></th>
                    </tr></thead>
                    <tbody>
                    @foreach (var row in Model)
                    {
                        var allowed = canRetry && enabled && row.CanRetry;
                        <tr data-payment-id="@row.Id">
                            <td>@if (allowed) { <input type="checkbox" class="payment-selection" aria-label="Select payment @row.OrderId" /> }</td>
                            <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm")<br />@row.StudentName<br /><small>Student @row.StudentId</small></td>
                            <td>Order: @row.OrderId<br />Gateway: @row.TransactionId</td>
                            <td>@row.Amount.ToString("N2")</td>
                            <td>@row.SourceChannel / @row.StatusId<br />@(row.IsCompleted ? "Completed" : "Not completed")</td>
                            <td>@(row.ReceiptId?.ToString() ?? "None")<br />@(row.ReceiptAmount?.ToString("N2"))</td>
                            <td>@(row.LastReconcileOn?.ToString("yyyy-MM-dd HH:mm") ?? "Not checked")<br />Attempts: @row.ReconcileAttemptCount</td>
                            <td class="payment-result">@(row.ReviewReason ?? (row.StatusId == 21 ? "Captured; wallet completion can be retried." : "Ready for gateway verification."))</td>
                            <td>@if (allowed) { <button type="button" class="btn btn-sm btn-outline-primary retry-one">Retry</button> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.Count == 0) { <p>No payments match these filters.</p> }
            <a asp-action="Index" asp-route-From="@filter.From.ToString("yyyy-MM-dd")" asp-route-To="@filter.To.ToString("yyyy-MM-dd")"
               asp-route-Reference="@filter.Reference" asp-route-IncludeCompleted="@filter.IncludeCompleted" class="btn btn-outline-secondary recovery-navigation">Refresh / first page</a>
            @if (hasMore)
            {
                <a asp-action="Index" asp-route-From="@filter.From.ToString("yyyy-MM-dd")" asp-route-To="@filter.To.ToString("yyyy-MM-dd")"
                   asp-route-Reference="@filter.Reference" asp-route-IncludeCompleted="@filter.IncludeCompleted"
                   asp-route-BeforeId="@nextId" class="btn btn-outline-secondary recovery-navigation">Next 50</a>
            }
        </div>
    </div>
</form>
@section Scripts {
    <script src="~/js/custom/v1-topup-recovery.js" asp-append-version="true"></script>
}
