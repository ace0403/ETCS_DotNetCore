@model ETCS.Shared.Infrastructure.Admin.Master.Guardians.GuardianChildrenViewModel
@{ Layout = null; }
<div class="modal-header">
    <h5 class="modal-title">Children — @Model.GuardianName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    @if (Model.Children.Count == 0)
    {
        <p class="text-muted mb-0 p-4">No students linked to this parent.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:70px"></th>
                        <th>Name</th>
                        <th>Card No</th>
                        <th>Std</th>
                        <th>School</th>
                        <th class="text-end">Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var child in Model.Children)
                    {
                        <tr>
                            <td class="text-center text-nowrap">
                                <a href="javascript:;" onclick="editChildData(@Model.GuardianId, @child.UserId)" title="Edit"><i class="fa fa-edit"></i></a>
                                <a href="javascript:;" class="ms-2" onclick="deleteChildData(@Model.GuardianId, @child.UserId)" title="Delete"><i class="fa fa-trash"></i></a>
                            </td>
                            <td>@child.Name</td>
                            <td>@child.CardNo</td>
                            <td>@child.Std</td>
                            <td>@child.SchoolName</td>
                            <td class="text-end">@child.Balance.ToString("0.00")</td>
                            <td>@child.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
</div>
