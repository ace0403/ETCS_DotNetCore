@using ETCS.Admin.Infrastructure.Auth
@{
    ViewData["Title"] = "Manage Parents";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AdminModuleKey = "Guardian";
}
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <partial name="_AdminGridSearch" />
            <div class="admin-grid-actions">
                @if (AdminPermissionViewHelper.CanAdd(User, "Guardian"))
                {
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addDataModal" onclick="loadData(0)">
                        <i class="ti ti-plus me-1"></i>Add
                    </button>
                }
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
        <table id="grid_table" class="table table-striped table-bordered nowrap w-100" style="width:100%">
            <thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Username</th><th class="text-center" style="width:70px"></th></tr></thead>
        </table>
        </div>
    </div>
</div>
<div class="modal fade" id="addDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content" id="div_add"></div></div>
</div>
<div class="modal fade" id="transferModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="div_transfer"></div></div>
</div>
<div class="modal fade" id="studentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" id="div_add_student"></div></div>
</div>
<div class="modal fade" id="childrenModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" id="div_children"></div></div>
</div>
<div class="modal fade" id="childEditModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" id="div_child_edit"></div></div>
</div>
@section Scripts {
    <link href="~/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/js/bootstrap-multiselect.js"></script>
    <script>window.adminModuleKey = 'Guardian';</script>
    <script src="~/js/custom/guardian.js"></script>
}
