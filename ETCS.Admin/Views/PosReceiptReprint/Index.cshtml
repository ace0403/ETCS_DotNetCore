@using ETCS.Admin.Infrastructure.Auth
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@{
    ViewData["Title"] = "POS Receipt Reprint";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var startDate = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    var endDate = DateTime.Today.ToString("yyyy-MM-dd");
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? Array.Empty<SchoolLookupDto>();
    var isScoped = User.IsSchoolScoped() && !User.IsAdminRole();
    var selectedSchoolId = isScoped && schools.Count == 1 ? schools[0].Id : 0;
}
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="txtFrom">From</label>
                <input class="form-control" type="date" id="txtFrom" value="@startDate" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="txtTo">To</label>
                <input class="form-control" type="date" id="txtTo" value="@endDate" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="ddlSchool">School</label>
                <select id="ddlSchool" class="form-select" @(isScoped && schools.Count == 1 ? "disabled" : null)>
                    <option value="">- Select School -</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id" selected="@(selectedSchoolId == school.Id)">@school.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="txtTerminalCode">Terminal code</label>
                <input class="form-control" id="txtTerminalCode" maxlength="50" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="txtTransactionId">Transaction ID</label>
                <input class="form-control" id="txtTransactionId" maxlength="100" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label" for="txtCustomerId">Customer ID</label>
                <input class="form-control" id="txtCustomerId" maxlength="50" />
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-primary" id="btnViewReport">
                    <span class="btn-label">Search</span>
                    <span class="btn-spinner spinner-border spinner-border-sm ms-1 d-none" role="status" aria-hidden="true"></span>
                </button>
                <div class="text-muted small mt-2">Date range is limited to 31 days. Thermal print requires ETCS.Pos.Bridge on this machine.</div>
            </div>
        </div>
    </div>
</div>

<div id="posReprintLoader" class="canteen-report-screen-loader d-none" aria-live="polite" aria-busy="true">
    <div class="canteen-report-loader-card">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="canteen-report-loader-text">Loading sales...</span>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card canteen-report-card">
            <div class="card-body">
                <div id="reportEmptyMessage" class="text-muted mb-2">Select date range and school, then click Search.</div>
                <div id="posReprintGridWrap" class="canteen-report-grid-wrap">
                    <div class="table-responsive canteen-report-table-scroll">
                        <table id="grid_table" class="table table-striped table-bordered canteen-report-table w-100">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Date / time</th>
                                    @* <th>Transaction</th> *@
                                    <th>Student / customer</th>
                                    <th>Payment</th>
                                    <th class="text-end">Amount</th>
                                    <th>Terminal</th>
                                    <th>Items</th>                                    
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary" id="btnPreviewReceipt" disabled>Preview</button>
                    <button type="button" class="btn btn-primary" id="btnBrowserPrint" disabled>Print (Browser)</button>
                    <button type="button" class="btn btn-success" id="btnThermalPrint" disabled title="Requires local Bridge">Print (Thermal / Bridge)</button>
                </div>
                <div id="bridge-status" class="small text-muted mb-2">Checking Bridge…</div>
                <div id="receipt-notice" class="alert alert-warning d-none" role="alert"></div>
                <div id="receipt-preview-host" class="pos-receipt-preview-host">
                    <div class="text-muted">Select a sale to preview the receipt.</div>
                </div>
                <div id="receipt-print-root" class="pos-receipt-print-root d-none"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.posReceiptReprintConfig = {
            listUrl: 'posreceiptreprint/getlist',
            detailUrl: '@Url.Action("Detail", "PosReceiptReprint")',
            bridgeBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.BridgeBaseUrl)),
            vatPercent: @(((decimal)ViewBag.VatPercent).ToString(System.Globalization.CultureInfo.InvariantCulture)),
            companyLine: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.CompanyLine)),
            vatRegNoLine: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.VatRegNoLine)),
            logoBase64: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.LogoBase64))
        };
    </script>
    <script src="~/js/custom/pos-receipt-reprint.js" asp-append-version="true"></script>
}
