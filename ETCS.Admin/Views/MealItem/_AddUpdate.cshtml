@model ETCS.Shared.Infrastructure.Admin.Inventory.MealItems.MealItemSaveRequest
@using ETCS.Shared.Infrastructure.Admin.Inventory.MealItems
@using ETCS.Shared.Infrastructure.Admin.Inventory.Categories
@using ETCS.Shared.Infrastructure.Admin.Inventory.MealEnums
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@using ETCS.Shared.Media
@inject MealImageUrlBuilder ImageUrlBuilder
@{
    Layout = null;
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? [];
    var categories = ViewBag.Categories as IReadOnlyList<CategoryListItemDto> ?? [];
    var mealTypes = ViewBag.MealTypes as IReadOnlyList<MealEnumLookupDto> ?? [];
    var ingredients = ViewBag.Ingredients as IReadOnlyList<MealEnumLookupDto> ?? [];
    var weekDays = ViewBag.WeekDays as IReadOnlyList<MealEnumLookupDto> ?? [];
    var weekNumbers = ViewBag.WeekNumbers as IReadOnlyList<int> ?? [1, 2, 3, 4];
    var nutritionTypes = ViewBag.NutritionTypes as IReadOnlyList<MealEnumLookupDto> ?? [];
    var measureTypes = ViewBag.MeasureTypes as IReadOnlyList<MealEnumLookupDto> ?? [];
    var nutritionLines = Model.NutritionLines.Count > 0 ? Model.NutritionLines : [new MealItemNutritionLineDto()];
}
<form id="frmMealItem" enctype="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id > 0 ? "Edit" : "Add") Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageName" />
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="ItemName" class="form-label">Item Name</label>
                <input asp-for="ItemName" class="form-control" placeholder="Item Name" />
                <span asp-validation-for="ItemName" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="SchoolId" class="form-label">School</label>
                <select asp-for="SchoolId" class="form-select">
                    <option value="">- Select school -</option>
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id">@school.Name</option>
                    }
                </select>
                <span asp-validation-for="SchoolId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="MealTypeId" class="form-label">Meal Type</label>
                <select asp-for="MealTypeId" class="form-select">
                    <option value="">- Select meal type -</option>
                    @foreach (var mealType in mealTypes)
                    {
                        <option value="@mealType.Id">@mealType.Name</option>
                    }
                </select>
                <span asp-validation-for="MealTypeId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="MealCategoryId" class="form-label">Menu Type</label>
                <select asp-for="MealCategoryId" class="form-select">
                    <option value="">- Select menu type -</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.CategoryName</option>
                    }
                </select>
                <span asp-validation-for="MealCategoryId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 multiselect-custom">
                <label class="form-label">Ingredients</label>
                <select name="IngredientIds" id="IngredientIds" class="form-select" multiple="multiple">
                    @foreach (var ingredient in ingredients)
                    {
                        if (Model.IngredientIds.Contains(ingredient.Id))
                        {
                            <option value="@ingredient.Id" selected="selected">@ingredient.Name</option>
                        }
                        else
                        {
                            <option value="@ingredient.Id">@ingredient.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 multiselect-custom">
                <label class="form-label">Week No.</label>
                <select name="WeekNos" id="WeekNos" class="form-select" multiple="multiple">
                    @foreach (var weekNo in weekNumbers)
                    {
                        if (Model.WeekNos.Contains(weekNo))
                        {
                            <option value="@weekNo" selected="selected">@weekNo</option>
                        }
                        else
                        {
                            <option value="@weekNo">@weekNo</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 multiselect-custom">
                <label class="form-label">Day</label>
                <select name="DayIds" id="DayIds" class="form-select" multiple="multiple">
                    @foreach (var day in weekDays)
                    {
                        if (Model.DayIds.Contains(day.Id))
                        {
                            <option value="@day.Id" selected="selected">@day.Name</option>
                        }
                        else
                        {
                            <option value="@day.Id">@day.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Nutrition</label>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-2" id="nutritionTable">
                        <thead>
                            <tr>
                                <th>Nutrition</th>
                                <th style="width:120px">Weight</th>
                                <th>Measure</th>
                                <th style="width:50px"></th>
                            </tr>
                        </thead>
                        <tbody id="nutritionRows">
                            @for (var i = 0; i < nutritionLines.Count; i++)
                            {
                                <tr class="nutrition-row">
                                    <td>
                                        <select name="NutritionLines[@i].NutritionId" class="form-select form-select-sm">
                                            <option value="">- Select -</option>
                                            @foreach (var nutrition in nutritionTypes)
                                            {
                                                if (nutritionLines[i].NutritionId == nutrition.Id)
                                                {
                                                    <option value="@nutrition.Id" selected="selected">@nutrition.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@nutrition.Id">@nutrition.Name</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="NutritionLines[@i].MeasureValue" class="form-control form-control-sm" step="0.01" value="@nutritionLines[i].MeasureValue" />
                                    </td>
                                    <td>
                                        <select name="NutritionLines[@i].MeasureTypeId" class="form-select form-select-sm">
                                            <option value="">- Select -</option>
                                            @foreach (var measure in measureTypes)
                                            {
                                                if (nutritionLines[i].MeasureTypeId == measure.Id)
                                                {
                                                    <option value="@measure.Id" selected="selected">@measure.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@measure.Id">@measure.Name</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-nutrition" title="Remove">&times;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" id="btnAddNutrition" class="btn btn-sm btn-outline-primary">+ Add nutrition</button>
            </div>
            <div class="col-12">
                <label asp-for="Detail" class="form-label"></label>
                <textarea asp-for="Detail" class="form-control" rows="3" placeholder="Detail"></textarea>
                <span asp-validation-for="Detail" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Upload file</label>
                <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrWhiteSpace(Model.ImageName))
                {
                    <div class="mt-2">
                        <img src="@ImageUrlBuilder.GetThumbnailPath(MealImageKind.MealItem, Model.ImageName)" alt="Meal thumbnail" class="img-thumbnail" style="max-height: 80px;" />
                    </div>
                }
            </div>
            <div class="col-12 col-md-6">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
    </div>
    <template id="nutritionRowTemplate">
        <tr class="nutrition-row">
            <td>
                <select data-name="NutritionId" class="form-select form-select-sm">
                    <option value="">- Select -</option>
                    @foreach (var nutrition in nutritionTypes)
                    {
                        <option value="@nutrition.Id">@nutrition.Name</option>
                    }
                </select>
            </td>
            <td>
                <input type="number" data-name="MeasureValue" class="form-control form-control-sm" step="0.01" value="0" />
            </td>
            <td>
                <select data-name="MeasureTypeId" class="form-select form-select-sm">
                    <option value="">- Select -</option>
                    @foreach (var measure in measureTypes)
                    {
                        <option value="@measure.Id">@measure.Name</option>
                    }
                </select>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-nutrition" title="Remove">&times;</button>
            </td>
        </tr>
    </template>
</form>
