@{
    ViewData["Title"] = "Item Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AdminModuleKey = "MealItem";
}
@using System.Text.Json
@using ETCS.Shared.Infrastructure.Admin.Inventory.MealEnums
<div class="card">
    <div class="card-body">
        <div class="admin-grid-toolbar">
            <partial name="_AdminGridSearch" />
            <partial name="_AdminGridSchoolFilter" />
            <partial name="_AdminGridOrderTypeFilter" />
            <div class="admin-grid-actions">
                <button type="button" class="btn btn-outline-secondary" id="btnOpenImport"><i class="ti ti-upload"></i> Import</button>
                <partial name="_AdminAddButton" />
            </div>
        </div>
        <div class="table-responsive admin-grid-table-scroll">
        <table id="grid_table" class="table table-striped table-bordered w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Order Type</th>
                    <th>Price</th>
                    <th>Active</th>
                    <th class="text-center" style="width:70px"></th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>
<div class="modal fade" id="addDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="div_add"></div>
    </div>
</div>
<div class="modal fade" id="importDataModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" id="div_import"></div>
    </div>
</div>
@section Scripts {
    <link href="~/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/js/bootstrap-multiselect.js"></script>
    <script>window.adminModuleKey = 'MealItem';</script>
    <script>window.MEAL_ITEM_CHANNEL = @Html.Raw(JsonSerializer.Serialize(MealItemChannelOptionIds.JavaScriptChannelIds));</script>
    <script src="~/js/custom/mealitem.js"></script>
}
