@using ETCS.Shared.Infrastructure.Admin.Inventory.MealEnums
@using ETCS.Shared.Infrastructure.Admin.Master.Students
@{
    Layout = null;
    var schools = ViewBag.Schools as IReadOnlyList<SchoolLookupDto> ?? [];
    var mealSessions = ViewBag.MealSessions as IReadOnlyList<MealEnumLookupDto> ?? [];
}
<form id="frmMealItemImport">
    <div class="modal-header">
        <h5 class="modal-title">Import Meal Items</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div id="importStepUpload">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="importSchoolId" class="form-label">School</label>
                    <select id="importSchoolId" name="schoolId" class="form-select" required>
                        <option value="">- Select school -</option>
                        @foreach (var school in schools)
                        {
                            <option value="@school.Id">@school.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label for="importMealSessionId" class="form-label">Meal Session</label>
                    <select id="importMealSessionId" name="mealSessionId" class="form-select" required>
                        <option value="">- Select meal session -</option>
                        @foreach (var mealSession in mealSessions)
                        {
                            <option value="@mealSession.Id">@mealSession.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label for="importMealTypeId" class="form-label">Meal Type</label>
                    <select id="importMealTypeId" name="mealTypeId" class="form-select" required disabled="disabled">
                        <option value="">- Select meal type -</option>
                    </select>
                </div>
                <div class="col-12">
                    <label for="importFile" class="form-label">Excel file (.xlsx)</label>
                    <input type="file" id="importFile" name="file" class="form-control" accept=".xlsx" required />
                    <div class="form-text">Imports item rows from Week 1-4 Detailed sheets.</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="importCreateMissingCategories" name="createMissingCategories" value="true" />
                        <label class="form-check-label" for="importCreateMissingCategories">Create missing menu categories</label>
                    </div>
                    <div class="form-text">When enabled, new menu categories from the file are added during preview before items are validated.</div>
                </div>
            </div>
        </div>

        <div id="importStepReview" class="d-none">
            <div class="row g-2 mb-3">
                <div class="col-6 col-md">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">To insert</div>
                        <div id="importCountToInsert" class="fs-5 fw-semibold text-success">0</div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Already exist</div>
                        <div id="importCountExists" class="fs-5 fw-semibold text-warning">0</div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Invalid</div>
                        <div id="importCountInvalid" class="fs-5 fw-semibold text-danger">0</div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Categories created</div>
                        <div id="importCountCategoriesCreated" class="fs-5 fw-semibold text-primary">0</div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Parsed</div>
                        <div id="importCountParsed" class="fs-5 fw-semibold">0</div>
                    </div>
                </div>
            </div>

            <div id="importCategoriesCreated" class="alert alert-info d-none mb-3"></div>

            <div id="importWarnings" class="alert alert-warning d-none mb-3"></div>

            <div class="table-responsive" style="max-height: 320px;">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Weeks</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody id="importPreviewRows"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnImportBack" class="btn btn-outline-secondary d-none">Back</button>
        <button type="button" id="btnImportPreview" class="btn btn-primary">Preview</button>
        <button type="button" id="btnImportConfirm" class="btn btn-success d-none" disabled>Confirm Import</button>
    </div>
</form>
